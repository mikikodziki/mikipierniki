---
import "@/styles/global.css";
import CookieSprite from "@/components/CookieSprite.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import MobileCta from "@/components/MobileCta.astro";
import { seasonFor, seasonRanges, site } from "@/lib/site";

interface Props {
  /** Page name; the site name is appended automatically */
  title?: string;
  description?: string;
  /** Hide the sticky mobile "Zapisz się" bar (e.g. on the workshops page itself) */
  mobileCta?: boolean;
  /** JSON-LD object(s) for structured data */
  jsonLd?: object | object[];
}

const {
  title,
  description = `${site.tagline}. Małe grupy, wszystkie materiały w cenie, pierniki do zabrania do domu.`,
  mobileCta = true,
  jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · warsztaty dekorowania pierników`;
// Bez ustawionej domeny (astro.config.mjs) nie wypisujemy canonical ani og:url.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const buildSeason = seasonFor(new Date());
const ranges = JSON.stringify(seasonRanges.map((r) => [r.season, r.from[0] * 100 + r.from[1], r.to[0] * 100 + r.to[1]]));
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="pl" data-season={buildSeason}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="theme-color" content="#F5E5BD" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,800,100,1&family=Figtree:wght@400;500;600;700&display=swap" />
    <script is:inline define:vars={{ ranges }}>
      // Pick the season from the visitor's date (or ?sezon=) before first paint.
      (function () {
        var p = new URLSearchParams(location.search).get("sezon");
        var d = new Date(), md = (d.getMonth() + 1) * 100 + d.getDate(), s = "rok";
        JSON.parse(ranges).forEach(function (r) { if (md >= r[1] && md <= r[2]) s = r[0]; });
        if (p === "swieta" || p === "wielkanoc" || p === "rok") s = p;
        document.documentElement.dataset.season = s;
      })();
    </script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <CookieSprite />
    <a class="skip" href="#main">Przejdź do treści</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {mobileCta && <MobileCta />}
    <slot name="end" />

<script>
  /**
   * Replaces the OS dropdown list with one we can style. The native <select>
   * stays in the DOM and keeps the value, so forms and scripts are unaffected.
   */
  function enhance(select: HTMLSelectElement) {
    if (select.dataset.enhanced) return;
    select.dataset.enhanced = "1";

    const shell = document.createElement("div");
    shell.className = "select-shell";
    select.parentNode!.insertBefore(shell, select);
    shell.appendChild(select);
    select.tabIndex = -1;
    select.setAttribute("aria-hidden", "true");

    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "sel";
    btn.setAttribute("aria-haspopup", "listbox");
    btn.setAttribute("aria-expanded", "false");
    const label = select.closest("label");
    if (label) btn.setAttribute("aria-label", (label.textContent || "").trim());

    const list = document.createElement("ul");
    list.className = "sel-list";
    list.setAttribute("role", "listbox");
    list.hidden = true;
    list.id = `${select.id || "sel"}-list`;
    btn.setAttribute("aria-controls", list.id);

    const options = [...select.options];
    const items = options.map((opt, i) => {
      const li = document.createElement("li");
      li.className = "sel-opt";
      li.setAttribute("role", "option");
      li.id = `${list.id}-${i}`;
      li.textContent = opt.textContent;
      li.setAttribute("aria-selected", String(opt.selected));
      list.appendChild(li);
      return li;
    });

    shell.append(btn, list);
    let active = Math.max(0, select.selectedIndex);

    const paint = () => {
      btn.textContent = options[select.selectedIndex]?.textContent ?? "";
      items.forEach((li, i) => {
        li.setAttribute("aria-selected", String(i === select.selectedIndex));
        li.classList.toggle("is-active", i === active && !list.hidden);
      });
      if (!list.hidden) {
        btn.setAttribute("aria-activedescendant", items[active].id);
        items[active].scrollIntoView({ block: "nearest" });
      } else {
        btn.removeAttribute("aria-activedescendant");
      }
    };

    const open = () => { list.hidden = false; btn.setAttribute("aria-expanded", "true"); active = Math.max(0, select.selectedIndex); paint(); };
    const close = () => { list.hidden = true; btn.setAttribute("aria-expanded", "false"); paint(); };
    const pick = (i: number) => {
      select.selectedIndex = i;
      select.dispatchEvent(new Event("input", { bubbles: true }));
      select.dispatchEvent(new Event("change", { bubbles: true }));
      close();
      btn.focus();
    };

    btn.addEventListener("click", () => (list.hidden ? open() : close()));
    items.forEach((li, i) => {
      li.addEventListener("click", () => pick(i));
      li.addEventListener("mousemove", () => { active = i; paint(); });
    });

    btn.addEventListener("keydown", (e) => {
      const last = items.length - 1;
      if (e.key === "ArrowDown" || e.key === "ArrowUp" || e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        if (list.hidden) { open(); return; }
        if (e.key === "Enter" || e.key === " ") { pick(active); return; }
        active = e.key === "ArrowDown" ? Math.min(last, active + 1) : Math.max(0, active - 1);
        paint();
      } else if (e.key === "Home" || e.key === "End") {
        if (list.hidden) return;
        e.preventDefault();
        active = e.key === "Home" ? 0 : last;
        paint();
      } else if (e.key === "Escape" && !list.hidden) {
        e.preventDefault();
        close();
      } else if (e.key === "Tab" && !list.hidden) {
        close();
      } else if (e.key.length === 1) {
        const from = list.hidden ? select.selectedIndex : active;
        const needle = e.key.toLowerCase();
        const found = options.findIndex((o, i) => i > from && (o.textContent || "").trim().toLowerCase().startsWith(needle));
        const hit = found >= 0 ? found : options.findIndex((o) => (o.textContent || "").trim().toLowerCase().startsWith(needle));
        if (hit >= 0) { active = hit; if (list.hidden) pick(hit); else paint(); }
      }
    });

    document.addEventListener("click", (e) => {
      if (!list.hidden && !shell.contains(e.target as Node)) close();
    });
    // other scripts may set select.value directly
    select.addEventListener("change", () => paint());
    paint();
  }

  document.querySelectorAll<HTMLSelectElement>("select.input").forEach(enhance);
</script>
  </body>
</html>

<style>
  /* hidden until tabbed to; clipped rather than pushed off-screen, so a
     collapsing margin above can never reveal it */
  .skip {
    position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }
  .skip:focus {
    position: fixed; top: calc(env(safe-area-inset-top, 0px) + 12px); left: 16px;
    width: auto; height: auto; clip-path: none; z-index: 60;
    background: var(--ink); color: var(--ground);
    padding: 12px 18px; border-radius: 12px; text-decoration: none; font-weight: 600;
  }
</style>

---
/**
 * Picks the photo shown on a term card. Closed, it shows the chosen photo with its caption; opened,
 * it lists every gallery photo as a thumbnail, grouped by the gallery's categories. The choice is a
 * plain radio group (`name`), so the form posts it like any other field and keyboard users move
 * through it with the arrow keys. Thumbnails sit in a closed <details>, so they load only when opened.
 */
import { galleryCategories, termPhotos } from "@/lib/api";

interface Props {
  name: string;
  label: string;
  /** The photo to start from; the first gallery photo when missing or unknown */
  value?: string;
}
const { name, label, value } = Astro.props;
const photos = termPhotos();
const current = photos.find((p) => p.photo === value) ?? photos[0];
const known = new Set(galleryCategories.map((c) => c.value));
const groups = [
  ...galleryCategories.map((c) => ({ label: c.label, items: photos.filter((p) => p.category === c.value) })),
  { label: "Inne", items: photos.filter((p) => !known.has(p.category)) },
].filter((g) => g.items.length);
const thumb = (photo: string) => `/zdjecia/${photo}-400.webp`;
const id = `pp-${name}`;
---
<div class="field photo-picker">
  <span id={`${id}-label`}>{label}</span>
  <details class="pp">
    {/* read as "Zdjęcie na karcie, <caption>"; without JS the closed view keeps the photo the page opened with */}
    <summary class="pp-current" aria-labelledby={`${id}-label ${id}-caption`}>
      <img src={thumb(current.photo)} alt="" width="400" height="300" data-pp-img />
      <span class="pp-caption" id={`${id}-caption`} data-pp-caption>{current.caption}</span>
      <span class="pp-change" aria-hidden="true">Zmień</span>
    </summary>
    <div class="pp-panel" role="radiogroup" aria-labelledby={`${id}-label`}>
      {groups.map((g) => (
        <fieldset class="pp-group">
          <legend>{g.label}</legend>
          <div class="pp-grid">
            {g.items.map((p) => (
              <label class="pp-tile">
                <input type="radio" name={name} value={p.photo} checked={p.photo === current.photo} data-caption={p.caption} />
                <img src={thumb(p.photo)} alt="" width="400" height="300" loading="lazy" />
                <span>{p.caption}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
    </div>
  </details>
</div>

<script>
  for (const picker of document.querySelectorAll<HTMLDetailsElement>(".photo-picker .pp")) {
    const img = picker.querySelector<HTMLImageElement>("[data-pp-img]")!;
    const caption = picker.querySelector<HTMLElement>("[data-pp-caption]")!;
    const summary = picker.querySelector("summary")!;
    const close = () => {
      picker.open = false;
      summary.focus();
    };
    picker.addEventListener("change", (e) => {
      const radio = e.target as HTMLInputElement;
      img.src = radio.nextElementSibling instanceof HTMLImageElement ? radio.nextElementSibling.src : img.src;
      caption.textContent = radio.dataset.caption ?? "";
    });
    // arrow keys move the choice and leave the panel open (the browser fires a click on the newly
    // checked radio for them too); a mouse click, Space or Enter picks and closes
    let arrow = false;
    picker.addEventListener("pointerdown", () => { arrow = false; });
    picker.addEventListener("keydown", (e) => {
      arrow = e.key.startsWith("Arrow");
      if (e.key === "Escape" && picker.open) close();
      // Enter on a radio would send the whole term form
      if (e.key === "Enter" && e.target instanceof HTMLInputElement) {
        e.preventDefault();
        close();
      }
    });
    // Space on the radio that is already checked fires no click, so it closes here
    picker.addEventListener("keyup", (e) => {
      if (e.key === " " && e.target instanceof HTMLInputElement) close();
    });
    picker.addEventListener("click", (e) => {
      if (!(e.target instanceof HTMLInputElement)) return;
      if (arrow) {
        arrow = false;
        return;
      }
      close();
    });
  }
</script>

<style>
  .photo-picker { display: grid; gap: 6px; }
  .pp { text-transform: none; letter-spacing: normal; font-size: 1rem; font-weight: 400; }
  .pp-current {
    display: flex; align-items: center; gap: 14px; cursor: pointer; list-style: none;
    background: var(--panel-deep); border-radius: var(--radius); padding: 8px 16px 8px 8px;
    box-shadow: inset 0 0 0 1px var(--field-line);
  }
  .pp-current:hover, .pp[open] .pp-current { background: var(--field-strong); }
  .pp-current::-webkit-details-marker { display: none; }
  .pp-current:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .pp-current img { width: 96px; height: 72px; object-fit: cover; border-radius: calc(var(--radius) - 2px); flex: none; }
  .pp-caption { flex: 1; color: var(--ink); font-weight: 400; }
  .pp-change { font-weight: 600; font-size: .9rem; color: var(--ginger-text); }
  .pp[open] .pp-change { visibility: hidden; }

  .pp-panel {
    margin-top: 8px; padding: 12px 16px 16px; display: grid; gap: 14px;
    max-height: min(70vh, 560px); overflow-y: auto;
    background: var(--card); border-radius: var(--radius); box-shadow: inset 0 0 0 1px var(--line);
  }
  .pp-group { border: 0; padding: 0; margin: 0; }
  .pp-group legend {
    padding: 0 0 8px; font-size: .75rem; font-weight: 600; letter-spacing: var(--caps); text-transform: uppercase; color: var(--ink-soft);
  }
  .pp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(132px, 1fr)); gap: 10px; }
  .pp-tile {
    position: relative; display: grid; gap: 6px; padding: 6px; border-radius: var(--radius); cursor: pointer;
    font-size: .85rem; line-height: 1.3; color: var(--ink);
  }
  .pp-tile:hover { background: var(--sunk); }
  .pp-tile img { width: 100%; aspect-ratio: 4 / 3; height: auto; object-fit: cover; border-radius: calc(var(--radius) - 2px); }
  /* the radio stays focusable and readable for screen readers; the tile shows the state */
  .pp-tile input { position: absolute; opacity: 0; inset: 6px auto auto 6px; margin: 0; }
  .pp-tile:has(input:checked) { box-shadow: inset 0 0 0 2px var(--accent); background: var(--sunk); }
  .pp-tile:has(input:checked)::after {
    content: "✓"; position: absolute; top: 10px; right: 10px; width: 24px; height: 24px; border-radius: 50%;
    display: grid; place-items: center; font-size: .8rem; font-weight: 700; color: #fff; background: var(--accent);
  }
  .pp-tile:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
</style>

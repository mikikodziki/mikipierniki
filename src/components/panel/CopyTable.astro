---
/** Database copies in the panel (Kopie): when, size, and "Przywróć…" when restoring from the panel is on. */
import { type BackupCopy, copyWhen } from "@/server/backups";

interface Props {
  copies: BackupCopy[];
  canRestore: boolean;
}
const { copies, canRestore } = Astro.props;
const size = (bytes: number) => (bytes < 1024 * 1024 ? `${Math.max(1, Math.round(bytes / 1024))} KB` : `${(bytes / 1024 / 1024).toFixed(1).replace(".", ",")} MB`);
---
<div class="scroll">
  <table class="tbl">
    <thead><tr><th>Zrobiona</th><th>Rozmiar</th>{canRestore && <th><span class="visually-hidden">Akcja</span></th>}</tr></thead>
    <tbody>
      {copies.map((c) => (
        <tr>
          <td class="nowrap">{copyWhen(c)}</td>
          <td data-label="Rozmiar">{size(c.bytes)}</td>
          {canRestore && (
            <td>
              <form method="post" action="/panel/kopie">
                <input type="hidden" name="action" value="request-restore" />
                <input type="hidden" name="copy" value={c.name} />
                <button class="btn btn-ghost btn-small" type="submit" aria-label={`Przywróć bazę: ${c.kind === "nightly" ? "kopia" : "stan sprzed przywrócenia"} z ${copyWhen(c)}`}>Przywróć…</button>
              </form>
            </td>
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .nowrap { white-space: nowrap; }
  form { margin: 0; }
</style>

---
/**
 * Photo from /public/zdjecia, served as WebP in three widths.
 * `name` is the file stem, e.g. "kamieniczki" → /zdjecia/kamieniczki-1000.webp
 */
interface Props {
  name: string;
  alt: string;
  /** CSS aspect-ratio for the frame, e.g. "4 / 3"; omit to keep the file's own shape */
  ratio?: string;
  /** Rendered width hint for the browser */
  sizes?: string;
  /** Available file widths; keep the largest within the source image's resolution. */
  widths?: [number, number, number];
  class?: string;
  /** First screenful images skip lazy loading */
  eager?: boolean;
  /** Crop focus, e.g. "50% 20%" to keep a face in frame */
  position?: string;
}
const { name, alt, ratio, sizes = "(max-width: 760px) 100vw, 50vw", widths = [600, 1000, 1600], class: className, eager = false, position } = Astro.props;
const base = `/zdjecia/${name}`;
---
<img
  class:list={["photo", className]}
  src={`${base}-${widths[1]}.webp`}
  srcset={widths.map((width) => `${base}-${width}.webp ${width}w`).join(", ")}
  sizes={sizes}
  alt={alt}
  loading={eager ? "eager" : "lazy"}
  decoding="async"
  style={[ratio && `aspect-ratio: ${ratio}`, position && `object-position: ${position}`].filter(Boolean).join("; ") || undefined}
/>

<style>
  .photo { display: block; width: 100%; height: 100%; object-fit: cover; max-width: 100%; }
</style>

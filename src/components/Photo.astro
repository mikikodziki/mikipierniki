---
/**
 * Photo from /public/zdjecia, served as WebP in three widths.
 * `name` is the file stem, e.g. "kamieniczki" → /zdjecia/kamieniczki-1000.webp
 */
interface Props {
  name: string;
  alt: string;
  /** CSS aspect-ratio for the frame, e.g. "4 / 3"; omit to keep the file's own shape */
  ratio?: string;
  /** Rendered width hint for the browser */
  sizes?: string;
  class?: string;
  /** First screenful images skip lazy loading */
  eager?: boolean;
}
const { name, alt, ratio, sizes = "(max-width: 760px) 100vw, 50vw", class: className, eager = false } = Astro.props;
const base = `/zdjecia/${name}`;
---
<img
  class:list={["photo", className]}
  src={`${base}-1000.webp`}
  srcset={`${base}-600.webp 600w, ${base}-1000.webp 1000w, ${base}-1600.webp 1600w`}
  sizes={sizes}
  alt={alt}
  loading={eager ? "eager" : "lazy"}
  decoding="async"
  style={ratio ? `aspect-ratio: ${ratio}` : undefined}
/>

<style>
  .photo { display: block; width: 100%; height: 100%; object-fit: cover; max-width: 100%; }
</style>

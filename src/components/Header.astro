---
import { nav, site } from "@/lib/site";

const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
---
<header class="top">
  <div class="bar">
    <a class="brand" href="/">{site.name}</a>
    <nav class="main" aria-label="Główne">
      {nav.map((l) => (
        <a href={l.href} aria-current={path === l.href ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="actions">
      <a class="btn btn-primary btn-small cta" href="/warsztaty">Zapisz się</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" id="menu-btn">
        <span class="visually-hidden">Menu</span>
        <span class="burger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Menu mobilne" hidden>
    {nav.map((l) => (
      <a href={l.href} aria-current={path === l.href ? "page" : undefined}>{l.label}</a>
    ))}
  </nav>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  const setOpen = (open: boolean) => {
    btn?.setAttribute("aria-expanded", String(open));
    if (menu) menu.hidden = !open;
    // the fixed bottom CTA would cover the last links on short screens
    document.documentElement.toggleAttribute("data-menu-open", open);
  };
  const isOpen = () => btn?.getAttribute("aria-expanded") === "true";
  btn?.addEventListener("click", () => setOpen(!isOpen()));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) {
      setOpen(false);
      btn?.focus();
    }
  });
  // a tap or focus outside the header closes the menu
  const outside = (e: Event) => {
    if (isOpen() && !(e.target as Element).closest?.(".top")) setOpen(false);
  };
  document.addEventListener("click", outside);
  document.addEventListener("focusin", outside);
</script>

<style>
  .top {
    position: sticky;
    top: calc(env(safe-area-inset-top, 0px) + var(--panel-gap));
    z-index: 20;
    padding-inline: var(--panel-gap);
    margin-block: var(--panel-gap);
  }
  /* phones in landscape: a stuck bar would take a fifth of the screen, so it scrolls away */
  @media (orientation: landscape) and (max-height: 500px) {
    .top { position: relative; top: auto; }
  }
  .bar {
    max-width: var(--panel-max);
    margin-inline: auto;
    height: 72px;
    padding: 0 18px 0 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--surface);
    color: var(--ink);
    border-radius: var(--radius-panel);
    box-shadow: var(--panel-shadow);
  }

  .brand {
    font-family: var(--display);
    font-weight: var(--display-weight);
    font-size: 1.6rem;
    letter-spacing: .01em;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .main { display: flex; gap: 30px; font-weight: 400; font-size: 0.75rem; letter-spacing: var(--caps); text-transform: uppercase; }
  .main a {
    text-decoration: none; color: var(--ink-soft);
    transition: color .16s ease;
  }
  .main a[aria-current="page"] { color: var(--accent); font-weight: 600; }
  .main a:hover, .main a:focus-visible { color: var(--nav-hover); }

  .actions { display: flex; align-items: center; gap: 10px; }
  .cta { padding: 13px 20px; }
  .menu-btn {
    display: none; width: 44px; height: 44px; border-radius: 999px;
    border: 0; background: var(--sage);
    cursor: pointer; place-items: center;
  }
  .burger, .burger::before, .burger::after { display: block; width: 18px; height: 2px; background: var(--ink); border-radius: 2px; position: relative; content: ""; }
  .burger::before { position: absolute; top: -6px; }
  .burger::after { position: absolute; top: 6px; }
  .menu-btn[aria-expanded="true"] .burger { background: transparent; }
  .menu-btn[aria-expanded="true"] .burger::before { top: 0; transform: rotate(45deg); }
  .menu-btn[aria-expanded="true"] .burger::after { top: 0; transform: rotate(-45deg); }

  .mobile-menu {
    max-width: var(--panel-max);
    margin: 8px auto 0;
    padding: 8px 20px 14px;
    display: grid;
    background: var(--surface);
    color: var(--ink);
    border-radius: var(--radius-panel);
    /* phones in landscape: the menu scrolls instead of running off the screen */
    max-height: calc(100dvh - 110px);
    overflow-y: auto;
  }
  .mobile-menu a { text-decoration: none; color: var(--ink); padding-block: 12px; font-size: 1.05rem; font-weight: 500; border-bottom: 1px solid var(--line); transition: color .16s ease; }
  .mobile-menu a:last-child { border-bottom: 0; }
  .mobile-menu a[aria-current="page"] { color: var(--accent); }
  .mobile-menu a:hover, .mobile-menu a:focus-visible { color: var(--nav-hover); }

  @media (max-width: 900px) {
    .main, .cta { display: none; }
    .menu-btn { display: grid; }
    .bar { height: 64px; padding: 0 12px 0 20px; }
    .brand { font-size: 1.25rem; }
  }
  @media (min-width: 901px) { .mobile-menu { display: none !important; } }
</style>

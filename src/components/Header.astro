---
import { nav, site } from "@/lib/site";
import Logo from "./Logo.astro";

const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
---
<header class="top">
  <div class="wrap bar">
    <a class="logo" href="/"><Logo label={site.name} /></a>
    <nav class="main" aria-label="Główne">
      {nav.map((l) => (
        <a href={l.href} aria-current={path === l.href ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="actions">
      <a class="btn btn-primary btn-small cta" href="/warsztaty">Zapisz się</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" id="menu-btn">
        <span class="visually-hidden">Menu</span>
        <span class="burger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Menu mobilne" hidden>
    <div class="wrap">
      {nav.map((l) => (
        <a href={l.href} aria-current={path === l.href ? "page" : undefined}>{l.label}</a>
      ))}
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!open));
    if (menu) menu.hidden = open;
  });
</script>

<style>
  .top {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
    background: color-mix(in srgb, var(--page) 92%, transparent);
    backdrop-filter: blur(10px);
    color: var(--on-page);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; height: 104px; }
  .logo { display: flex; align-items: center; text-decoration: none; color: var(--on-page); }
  .logo :global(.logo-mark) { height: 80px; width: auto; }
  @media (max-width: 900px) { .bar { height: 88px; } .logo :global(.logo-mark) { height: 66px; } }
  @media (max-width: 420px) { .logo :global(.logo-mark) { height: 56px; } }
  .main { display: flex; gap: 26px; font-weight: 500; font-size: 0.95rem; }
  .main a { text-decoration: none; color: var(--on-page-soft); }
  .mobile-menu a { text-decoration: none; color: var(--ink); }
  .main a:hover, .main a[aria-current="page"] { color: var(--on-page); }
  .main a[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--mango); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .actions { display: flex; align-items: center; gap: 10px; }
  .menu-btn { display: none; width: 44px; height: 44px; border-radius: 12px; border: 1px solid color-mix(in srgb, var(--on-page) 35%, transparent); background: transparent; cursor: pointer; place-items: center; }
  .burger, .burger::before, .burger::after { display: block; width: 18px; height: 2px; background: var(--on-page); border-radius: 2px; position: relative; content: ""; }
  .burger::before { position: absolute; top: -6px; }
  .burger::after { position: absolute; top: 6px; }
  .menu-btn[aria-expanded="true"] .burger { background: transparent; }
  .menu-btn[aria-expanded="true"] .burger::before { top: 0; transform: rotate(45deg); }
  .menu-btn[aria-expanded="true"] .burger::after { top: 0; transform: rotate(-45deg); }
  .mobile-menu { background: var(--ground); color: var(--ink); margin: 0 var(--panel-gap) var(--panel-gap); border-radius: var(--radius-panel); }
  .mobile-menu .wrap { display: grid; padding-block: 8px 16px; }
  .mobile-menu a:last-child { border-bottom: 0; }
  .mobile-menu a { padding-block: 12px; font-size: 1.1rem; font-weight: 500; border-bottom: 1px solid var(--line); }
  .mobile-menu a[aria-current="page"] { color: var(--ink); }
  @media (max-width: 900px) {
    .main, .cta { display: none; }
    .menu-btn { display: grid; }
  }
  @media (min-width: 901px) { .mobile-menu { display: none !important; } }
</style>

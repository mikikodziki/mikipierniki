---
import { nav, site } from "@/lib/site";

const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
---
<header class="top">
  <div class="bar">
    <a class="brand" href="/">{site.name}</a>
    <nav class="main" aria-label="Główne">
      {nav.map((l) => (
        <a href={l.href} aria-current={path === l.href ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="actions">
      <a class="btn btn-primary btn-small cta" href="/warsztaty">Zapisz się</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" id="menu-btn">
        <span class="visually-hidden">Menu</span>
        <span class="burger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Menu mobilne" hidden>
    {nav.map((l) => (
      <a href={l.href} aria-current={path === l.href ? "page" : undefined}>{l.label}</a>
    ))}
  </nav>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!open));
    if (menu) menu.hidden = open;
  });
</script>

<style>
  .top {
    position: sticky;
    top: calc(env(safe-area-inset-top, 0px) + var(--panel-gap));
    z-index: 20;
    padding-inline: var(--panel-gap);
    margin-block: var(--panel-gap);
  }
  .bar {
    max-width: var(--panel-max);
    margin-inline: auto;
    height: 64px;
    padding: 0 14px 0 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--dark);
    color: var(--on-dark);
    border-radius: 999px;
    box-shadow: 0 10px 24px rgba(59, 23, 32, .16);
  }

  .brand {
    font-family: var(--display);
    font-weight: var(--display-weight);
    font-size: 1.3rem;
    line-height: 1;
    color: var(--on-dark);
    text-decoration: none;
    white-space: nowrap;
  }

  .main { display: flex; gap: 26px; font-weight: 500; font-size: 0.95rem; }
  .main a { text-decoration: none; color: color-mix(in srgb, var(--on-dark) 78%, transparent); }
  .main a:hover, .main a[aria-current="page"] { color: var(--on-dark); }
  .main a[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--mango); text-decoration-thickness: 2px; text-underline-offset: 6px; }

  .actions { display: flex; align-items: center; gap: 10px; }
  /* the pill curves away at its ends, so the CTA keeps an even inset */
  .cta { padding: 11px 20px; }
  .menu-btn {
    display: none; width: 44px; height: 44px; border-radius: 999px;
    border: 0; background: color-mix(in srgb, var(--on-dark) 14%, transparent);
    cursor: pointer; place-items: center;
  }
  .burger, .burger::before, .burger::after { display: block; width: 18px; height: 2px; background: var(--on-dark); border-radius: 2px; position: relative; content: ""; }
  .burger::before { position: absolute; top: -6px; }
  .burger::after { position: absolute; top: 6px; }
  .menu-btn[aria-expanded="true"] .burger { background: transparent; }
  .menu-btn[aria-expanded="true"] .burger::before { top: 0; transform: rotate(45deg); }
  .menu-btn[aria-expanded="true"] .burger::after { top: 0; transform: rotate(-45deg); }

  .mobile-menu {
    max-width: var(--panel-max);
    margin: 8px auto 0;
    padding: 8px 20px 14px;
    display: grid;
    background: var(--dark);
    color: var(--on-dark);
    border-radius: var(--radius-lg);
  }
  .mobile-menu a { text-decoration: none; color: var(--on-dark); padding-block: 12px; font-size: 1.05rem; font-weight: 500; border-bottom: 1px solid color-mix(in srgb, var(--on-dark) 18%, transparent); }
  .mobile-menu a:last-child { border-bottom: 0; }

  @media (max-width: 900px) {
    .main, .cta { display: none; }
    .menu-btn { display: grid; }
    .bar { height: 60px; padding: 0 10px 0 20px; }
    .brand { font-size: 1.15rem; }
  }
  @media (min-width: 901px) { .mobile-menu { display: none !important; } }
</style>

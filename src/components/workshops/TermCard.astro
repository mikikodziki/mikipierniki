---
import type { Term } from "@/lib/types";
import { venueById } from "@/lib/api";
import { day, LOW_SEATS, month, pln, seatsWord, timeRange, weekday, workshopTypeLabel } from "@/lib/format";
import Photo from "../Photo.astro";

interface Props {
  term: Term;
}
const { term } = Astro.props;
const venue = venueById(term.venueId);
const soldOut = term.seatsLeft === 0;
const low = !soldOut && term.seatsLeft <= LOW_SEATS;
const pct = Math.round(((term.capacity - term.seatsLeft) / term.capacity) * 100);
---
<article class="term" data-type={term.type} data-term-id={term.id}>
  <div class="media">
    <Photo name={term.photo} alt={term.photoAlt} sizes="(max-width: 700px) 100vw, 33vw" />
  </div>

  <div class="panel">
    <div class="top">
      <span class="tag">{workshopTypeLabel[term.type]}</span>
      <p class="when">{day(term.startsAt)} {month(term.startsAt)} · {weekday(term.startsAt)} · {timeRange(term)}</p>
      <h3>{term.title}</h3>
    </div>

    <div class="more">
      <div class="more-in">
        <ul class="facts">
          <li>{venue.name}, {venue.address}</li>
          <li>{term.cookies} pierników do zabrania do domu</li>
          {term.type === "dzieci" && <li>Dzieci 6–12 lat z rodzicem</li>}
          {term.type === "wieczor" && <li>Lampka grzanego wina w cenie</li>}
        </ul>

        <div class:list={["seats", { low, soldOut }]}>
          <span>
            {soldOut ? (
              <><b>Brak miejsc</b> · lista rezerwowa</>
            ) : low ? (
              <><b>Zostały {term.seatsLeft} {seatsWord(term.seatsLeft)}</b> z {term.capacity}</>
            ) : (
              <>{term.seatsLeft} wolnych {seatsWord(term.seatsLeft)} z {term.capacity}</>
            )}
          </span>
          <div class="bar" role="presentation"><i style={`width:${pct}%`}></i></div>
        </div>

        <div class="foot">
          <span class="price">{pln(term.price)} <small>/ {term.priceUnit === "dziecko" ? "dziecko" : "os."}</small></span>
          <button class="btn btn-primary btn-small" type="button" data-book={term.id}>
            {soldOut ? "Lista rezerwowa" : "Zapisz się"}
          </button>
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .term {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--sunk);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .term:hover, .term:focus-within { transform: translateY(-4px); box-shadow: 0 18px 32px rgba(54, 21, 13, .3); }

  .media { position: absolute; inset: 0; }
  .media :global(.photo) { width: 100%; height: 100%; }

  .panel {
    position: absolute; left: 12px; right: 12px; bottom: 12px;
    background: var(--dark); color: var(--on-dark);
    border-radius: 20px; padding: 18px;
    display: grid;
  }
  .top { display: grid; gap: 8px; justify-items: start; }
  .tag {
    font-size: .7rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    color: var(--on-mango); background: var(--mango);
    padding: 5px 11px; border-radius: 999px;
  }
  .when { font-size: .88rem; color: color-mix(in srgb, var(--on-dark) 92%, transparent); }
  h3 { font-size: 1.25rem; color: var(--on-dark); }

  /* collapsed by default, rolls open on hover or keyboard focus */
  .more { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows .3s ease, opacity .25s ease; }
  .more-in { min-height: 0; overflow: hidden; display: grid; gap: 14px; padding-top: 14px; }
  .term:hover .more, .term:focus-within .more { grid-template-rows: 1fr; opacity: 1; }

  .facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: .92rem; color: color-mix(in srgb, var(--on-dark) 90%, transparent); }
  .seats { display: grid; gap: 6px; font-size: .85rem; color: color-mix(in srgb, var(--on-dark) 90%, transparent); }
  .seats b { color: var(--on-dark); }
  .bar { height: 6px; border-radius: 99px; background: color-mix(in srgb, var(--on-dark) 22%, transparent); overflow: hidden; }
  .bar i { display: block; height: 100%; background: var(--mango); border-radius: inherit; }
  .seats.low b, .seats.soldOut b { color: var(--accent-tint); }
  .seats.low .bar i, .seats.soldOut .bar i { background: var(--accent-tint); }

  .foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .price { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.4rem; color: var(--on-dark); }
  .price small { font-family: var(--body); font-weight: 400; font-size: .8rem; color: color-mix(in srgb, var(--on-dark) 85%, transparent); }

  /* touch screens have no hover: keep everything open */
  @media (hover: none) {
    .term { aspect-ratio: auto; }
    .media { position: relative; aspect-ratio: 4 / 3; }
    .panel { position: static; border-radius: 0 0 var(--radius-lg) var(--radius-lg); }
    .more { grid-template-rows: 1fr; opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .more { transition: none; } }
</style>

---
// A hairline between sections. Nothing more.
---
<div class="rule-row" aria-hidden="true"><span class="rule"></span></div>

<style>
  .rule-row {
    max-width: var(--panel-max); width: 100%; margin-inline: auto;
    padding: 10px clamp(20px, 3vw, 40px);
  }
  .rule { display: block; height: 1px; background: var(--line); }
</style>

---
/**
 * Mid-page homepage sections: how workshops work, audiences, custom orders.
 */
import Photo from "../Photo.astro";
import SectionHead from "../SectionHead.astro";

const facts = [
  { num: "3–4 h", title: "Spokojne tempo", text: "Tyle trwają warsztaty dla dorosłych i wieczorne. Dla dzieci: 2 godziny." },
  { num: "6–8", title: "Pierników do domu", text: "Tyle zdobisz i tyle zabierasz w pudełku. Lukier, który zostanie, też jest Twój." },
  { num: "0", title: "Potrzebne doświadczenie", text: "Zaczynamy od trzymania rękawa. Reszta przychodzi sama." },
  { num: "4–10", title: "Osób w grupie", text: "Tyle daję radę prowadzić spokojnie, z czasem dla każdego przy stole." },
];

const audiences: { photo: string; photoAlt: string; title: string; meta: string; text: string; href: string; go: string }[] = [
  { photo: "swieta-stol", photoAlt: "Piernikowe domki i misie na drewnianym stole", title: "Dla dorosłych", meta: "3–4 godziny · 450 zł", text: "Popołudnie tylko dla siebie albo w duecie z przyjaciółką.", href: "/warsztaty", go: "Terminy" },
  { photo: "gwiazdka-zlota", photoAlt: "Piernikowa gwiazdka w białym lukrze ze złotym wzorem", title: "Wieczorne z winem", meta: "3–4 godziny · 500 zł", text: "Wieczór przy lukrze i lampce grzanego wina, od 18 lat.", href: "/warsztaty", go: "Terminy" },
  { photo: "mis-choinka", photoAlt: "Piernikowy miś w szaliku i choinka z wesołą buzią", title: "Dla dzieci", meta: "2 godziny · 200 zł", text: "Dla dzieci 6–12 lat z rodzicem, starsze radzą sobie same.", href: "/warsztaty", go: "Terminy" },
  { photo: "kamieniczki", photoAlt: "Trzy piernikowe kamieniczki zdobione lukrem", title: "Firmowe i prywatne", meta: "Wycena indywidualna", text: "Integracja, urodziny albo wieczór panieński, u mnie lub z dojazdem.", href: "/warsztaty#firmy", go: "Zapytaj o ofertę" },
];

const orders: { photo: string; photoAlt: string; title: string; text: string; deadline: string; href: string }[] = [
  { photo: "swieta-mikolaj-domek", photoAlt: "Piernikowy Mikołaj i domek z czerwonymi drzwiami na różowym talerzu", title: "Boże Narodzenie", text: "Choinki, gwiazdki i zawieszki na choinkę. Zestaw w pudełku (1 duży, 2 średnie, 3 małe pierniki) kosztuje 120 zł.", deadline: "18 grudnia", href: "/zamowienia#swieta" },
  // DO POTWIERDZENIA: termin przyjmowania zamówień wielkanocnych
  { photo: "wielkanoc", photoAlt: "Piernikowe zajączki, kurczaczki i kury w pastelowych kolorach", title: "Wielkanoc", text: "Pisanki, zajączki i baranki z lukru. Do koszyczka albo jako upominek na stół.", deadline: "2 tygodni przed świętami", href: "/zamowienia#wielkanoc" },
  { photo: "kamieniczki", photoAlt: "Piernikowe kamieniczki zrobione na zamówienie", title: "Okazje i firmy", text: "Urodziny, walentynki, Halloween, śluby, a dla firm pierniki w kształcie Twojego logo: robię foremkę pod projekt.", deadline: "2 tygodni przed odbiorem", href: "/zamowienia#okazje" },
];
---
<section class="section">
  <div class="wrap">
    <SectionHead eyebrow="Jak wyglądają warsztaty" title="Przychodzisz z pustymi rękami, wychodzisz z pudełkiem pierników" />
    <div class="facts">
      {facts.map((f) => (
        <div class="fact"><span class="num">{f.num}</span><h3>{f.title}</h3><p>{f.text}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="section section--warm">
  <div class="wrap">
    <SectionHead eyebrow="Dla kogo" title="Warsztaty dopasowane do okazji" />
    <div class="aud">
      {audiences.map((a) => (
        <a class="card" href={a.href}>
          <span class="aud-pic"><Photo name={a.photo} alt={a.photoAlt} ratio="16 / 10" sizes="(max-width: 960px) 50vw, 25vw" /></span>
          <span class="aud-body">
            <span class="aud-meta">{a.meta}</span>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
            <span class="go">{a.go} →</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section section--sunk">
  <div class="wrap">
    <SectionHead eyebrow="Pierniki na zamówienie" title="Ręcznie dekorowane na każdą okazję" lead="Mały piernik 15 zł, średni 25 zł, duży 35 zł. Zestaw w pudełku 120 zł, a minimalne zamówienie to 100 zł. Każdy projektuję pod Ciebie." />
    <div class="orders">
      {orders.map((o) => (
        <article class="order card">
          <div class="pic"><Photo name={o.photo} alt={o.photoAlt} ratio="4 / 3" sizes="(max-width: 860px) 100vw, 33vw" /></div>
          <div class="body">
            <h3>{o.title}</h3>
            <p>{o.text}</p>
            <span class="deadline">Zamówienia najpóźniej do <span>{o.deadline}</span></span>
            <a class="btn btn-ghost btn-small" href={o.href}>Zobacz i zapytaj o wycenę</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .fact { display: grid; gap: 10px; align-content: start; background: var(--card); border-radius: var(--radius-lg); padding: clamp(24px, 3vw, 34px); }
  .num { font-family: var(--display); font-weight: var(--display-weight); font-size: clamp(2.6rem, 4vw, 3.4rem); color: var(--ginger); line-height: 1; }
  .fact h3 { font: 700 1.2rem/1.3 var(--body); }
  .fact p { color: var(--ink-soft); font-size: 1rem; line-height: 1.65; max-width: 34ch; }

  .aud { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .aud a { display: grid; grid-template-rows: auto 1fr; align-content: start; text-decoration: none; overflow: hidden; transition: transform .15s ease, background-color .15s ease; }
  .aud a:hover { transform: translateY(-2px); background: var(--card-hover); }
  .aud-pic { display: block; }
  .aud-body { display: grid; gap: 8px; align-content: start; padding: 20px 22px 22px; }
  .aud-meta { font-size: .78rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--ginger-text); }
  .aud p { color: var(--ink-soft); font-size: .95rem; }
  .go { font-weight: 600; font-size: .9rem; color: var(--accent); }

  .orders { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .order { display: grid; grid-template-rows: auto 1fr; overflow: hidden; }
  .pic { aspect-ratio: 4 / 3; max-width: 100%; overflow: hidden; }
  .body { display: grid; gap: 10px; padding: 22px; align-content: start; justify-items: start; }
  .body p { color: var(--ink-soft); font-size: .95rem; }
  .deadline { font-size: .85rem; font-weight: 600; }
  .deadline span { color: var(--berry); }

  @media (max-width: 960px) { .aud { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 860px) { .orders { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .facts, .aud { grid-template-columns: 1fr; } }
</style>

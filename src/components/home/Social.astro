---
/**
 * Lower homepage sections: gallery teaser, testimonials, voucher, about teaser.
 */
import Cookie from "../Cookie.astro";
import Photo from "../Photo.astro";
import SectionHead from "../SectionHead.astro";
import { getGallery, getTestimonials } from "@/lib/api";
import { site } from "@/lib/site";

const gallery = (await getGallery()).slice(0, 6);
const testimonials = await getTestimonials();
---
<section class="section">
  <div class="wrap">
    <SectionHead eyebrow="Galeria" title="Z pracowni i z warsztatów" />
    <div class="gallery">
      {gallery.map((g) => (
        <figure style={`background: var(--tile-${g.tile})`}>
          {g.photo ? <Photo name={g.photo} alt={g.alt} sizes="(max-width: 700px) 50vw, 25vw" /> : <Cookie shape={g.shape} class="g-cookie" label={g.alt} />}
          <figcaption>{g.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="more">
      <a class="btn btn-ghost btn-small" href="/galeria">Cała galeria</a>
      <a class="btn btn-ghost btn-small" href={site.instagram} rel="noopener">Instagram {site.instagramHandle}</a>
    </div>
  </div>
</section>

<section class="section section--sunk">
  <div class="wrap">
    <SectionHead eyebrow="Opinie uczestników" title="Co mówią po warsztatach" />
    <div class="quotes">
      {testimonials.map((t) => (
        <figure class="quote card">
          <div class="stars" aria-label="Ocena 5 na 5">★★★★★</div>
          <blockquote>„{t.text}”</blockquote>
          <figcaption><b>{t.author}</b> · {t.context}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="voucher">
      <div class="v-copy">
        <span class="eyebrow v-eyebrow">Voucher prezentowy</span>
        <h2>Podaruj popołudnie z lukrem</h2>
        <p class="lead v-lead">Voucher za 500 zł na dowolne warsztaty, ważny rok. Wysyłam PDF od ręki, a wersję drukowaną odbierzesz w pracowni.</p>
        <div><a class="btn v-btn" href="/warsztaty#voucher">Kup voucher</a></div>
      </div>
      <div class="ticket" aria-hidden="true">
        <small>Voucher · warsztaty</small>
        <b>{site.name}</b>
        <small>500 zł · ważny rok · 1 osoba</small>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap about">
    <div class="portrait">
      <Photo
        name="mis-choinka"
        alt="Piernikowy miś w zielonym szaliku i choinka z wesołą buzią na różowym talerzu"
        ratio="4 / 5"
        sizes="(max-width: 760px) 100vw, 35vw"
      />
    </div>
    <div class="a-copy">
      <span class="eyebrow">O mnie</span>
      <h2>Cześć, jestem Dominika</h2>
      <p class="lead">Piekę i dekoruję pierniki od czternastu lat. Zaczęło się od pieczenia z przyjaciółką, potem były pierniki dla rodziny i targi świąteczne, a skończyło się na pracowni, w której uczę innych, że lukier nie gryzie.</p>
      <p>Na warsztatach najbardziej lubię moment, w którym ktoś patrzy na swój pierwszy gotowy piernik i mówi: „to naprawdę ja zrobiłam?”. Dla takich chwil to robię.</p>
      <div><a class="btn btn-ghost btn-small" href="/o-mnie">Poznaj mnie bliżej</a></div>
    </div>
  </div>
</section>

<style>
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  figure { margin: 0; aspect-ratio: 1; max-width: 100%; border-radius: 12px; display: grid; place-items: center; position: relative; overflow: hidden; }
  figure img { width: 100%; height: 100%; object-fit: cover; }
  figure :global(.g-cookie) { width: 52%; }
  figcaption { position: absolute; left: 10px; bottom: 10px; font-size: .72rem; background: var(--surface); color: var(--ink-soft); padding: 3px 9px; border-radius: 99px; }
  .more { margin-top: 26px; display: flex; flex-wrap: wrap; gap: 12px; }

  .quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .quote { display: grid; grid-template-rows: auto 1fr auto; gap: 16px; padding: 26px; margin: 0; }
  .stars { color: var(--ginger); letter-spacing: 3px; font-size: .95rem; }
  blockquote { margin: 0; font-size: 1.02rem; }
  .quote figcaption { position: static; background: none; padding: 0; font-size: .88rem; }
  .quote figcaption b { color: var(--ink); font-weight: 600; }

  .voucher { display: grid; grid-template-columns: 1.2fr 1fr; gap: 32px; align-items: center; background: var(--accent); color: var(--accent-ink); border-radius: var(--radius-lg); padding: clamp(28px, 5vw, 56px); }
  .v-copy { display: grid; gap: 16px; }
  .v-eyebrow, .v-lead { color: inherit; opacity: .85; }
  .v-btn { background: var(--accent-ink); color: var(--accent); }
  .ticket { justify-self: center; width: 100%; max-width: 340px; aspect-ratio: 16 / 10; background: var(--icing); color: #2B1A12; border-radius: 16px; padding: 22px; display: grid; align-content: space-between; transform: rotate(-3deg); box-shadow: 0 18px 30px rgba(0, 0, 0, .22); position: relative; }
  .ticket::before, .ticket::after { content: ""; position: absolute; top: 50%; width: 22px; height: 22px; margin-top: -11px; border-radius: 50%; background: var(--accent); }
  .ticket::before { left: -11px; }
  .ticket::after { right: -11px; }
  .ticket b { font-family: var(--display); font-weight: 400; font-size: 1.5rem; }
  .ticket small { font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; color: #6E5A4E; }

  .about { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .portrait { aspect-ratio: 4 / 5; max-width: 100%; border-radius: 200px 200px 24px 24px; overflow: hidden; background: var(--sunk); }
  .a-copy { display: grid; gap: 18px; }

  @media (max-width: 860px) { .quotes { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .voucher, .about { grid-template-columns: 1fr; } .portrait { max-width: 340px; } }
  @media (max-width: 700px) { .gallery { grid-template-columns: repeat(2, 1fr); } }
</style>

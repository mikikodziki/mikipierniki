---
/**
 * Lower homepage sections: gallery teaser, testimonials, voucher, about teaser.
 */
import Cookie from "../Cookie.astro";
import Photo from "../Photo.astro";
import VoucherCard from "../VoucherCard.astro";
import SectionHead from "../SectionHead.astro";
import { getGallery, getTestimonials } from "@/lib/api";
import { site } from "@/lib/site";

const gallery = (await getGallery()).slice(0, 6);
const testimonials = await getTestimonials();
---
<section class="section section--sage">
  <div class="wrap">
    <SectionHead eyebrow="Galeria" title="Prosto z mojej pracowni" />
    <div class="gallery">
      {gallery.map((g) => (
        <figure style={`background: var(--tile-${g.tile})`}>
          {g.photo ? <Photo name={g.photo} alt={g.alt} sizes="(max-width: 700px) 60vw, (max-width: 1240px) 40vw, 470px" /> : <Cookie shape={g.shape} class="g-cookie" label={g.alt} />}
          <figcaption>{g.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="more">
      <a class="btn btn-ghost btn-small" href="/galeria">Cała galeria</a>
      <a class="btn btn-ghost btn-small" href={site.instagram} rel="noopener">Instagram {site.instagramHandle}</a>
    </div>
  </div>
</section>

{testimonials.length > 0 && (
<section class="section section--sunk" id="opinie" aria-labelledby="opinions-title">
  <div class="wrap">
    <SectionHead id="opinions-title" eyebrow="Opinie uczestników" title="Co mówią po warsztatach" lead="Po warsztatach wyszły piękne pierniki — każdy udekorowany po swojemu." />
    <!-- focusable so the sideways scroll (600–1100 px) also works from the keyboard -->
    <div class="quotes" role="region" aria-label="Opinie, przewiń w bok" tabindex="0">
      {testimonials.map((t) => (
        <figure class="quote card">
          {t.photo && <div class="quote-photo"><Photo name={t.photo} alt={t.photoAlt ?? "Pierniki udekorowane po warsztatach"} ratio="1" sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 25vw" /></div>}
          <div class="quote-body">
            <div class="stars" role="img" aria-label="Ocena 5 na 5">★★★★★</div>
            <blockquote>„{t.text}”</blockquote>
          </div>
          <figcaption><b>{t.author}</b> · {t.context}</figcaption>
        </figure>
      ))}
      <figure class="quote card quote--result">
        <div class="quote-photo">
          <Photo name="opinie-swiateczny-zestaw" alt="Pierniki z warsztatów: dzwonek z czerwoną kokardą, miś, bałwanek, jeż i dwie bombki" ratio="1" sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 25vw" />
        </div>
        <div class="quote-body">
          <span class="eyebrow">Efekty warsztatów</span>
          <h3>Każdy dekoruje po swojemu</h3>
          <p>Kolorowe lukry, własne wzory i piękne pierniki na zakończenie warsztatów.</p>
        </div>
        <figcaption>Prace uczestników</figcaption>
      </figure>
    </div>
  </div>
</section>
)}

<section class="section section--warm">
  <div class="wrap">
    <div class="voucher">
      <div class="v-copy">
        <span class="eyebrow v-eyebrow">Voucher prezentowy</span>
        <h2>Podaruj popołudnie z lukrem</h2>
        <p class="lead v-lead">Voucher za 500 zł na dowolne warsztaty, ważny rok. Wysyłam PDF od ręki, a wersję drukowaną odbierzesz w pracowni.</p>
        <div><a class="btn btn-deep" href="/warsztaty#voucher">Kup voucher</a></div>
      </div>
      <VoucherCard />
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap about">
    <div class="portrait">
      <Photo
        name="portret-dominika"
        widths={[600, 1000, 1254]}
        alt="Dominika, autorka Miki Pierniki"
        ratio="4 / 5"
        sizes="(max-width: 760px) 100vw, 35vw"
        position="50% 22%"
      />
    </div>
    <div class="a-copy">
      <span class="eyebrow">O mnie</span>
      <h2>Cześć, jestem Dominika</h2>
      <p class="lead">Piekę i dekoruję pierniki od czternastu lat. Zaczęło się od pieczenia z przyjaciółką, potem były pierniki dla rodziny i targi świąteczne, a skończyło się na pracowni, w której uczę innych, że lukier nie gryzie.</p>
      <p>Na warsztatach najbardziej lubię moment, w którym ktoś patrzy na swój pierwszy gotowy piernik i mówi: „to naprawdę ja zrobiłam?”. Dla takich chwil to robię.</p>
      <div><a class="btn btn-ghost btn-small" href="/o-mnie">Poznaj mnie bliżej</a></div>
    </div>
  </div>
</section>

<style>
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  figure { margin: 0; aspect-ratio: 1; max-width: 100%; border-radius: var(--radius); display: grid; place-items: center; position: relative; overflow: hidden; }
  figure img { width: 100%; height: 100%; object-fit: cover; }
  figure :global(.g-cookie) { width: 52%; }
  figcaption { position: absolute; left: 10px; bottom: 10px; font-size: .75rem; background: var(--surface); color: var(--ink-soft); padding: 3px 9px; border-radius: 99px; }
  .more { margin-top: 26px; display: flex; flex-wrap: wrap; gap: 12px; }

  .quotes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .quote { display: flex; flex-direction: column; align-items: stretch; aspect-ratio: auto; padding: 0; margin: 0; border-radius: var(--radius-panel); }
  .quote-photo { aspect-ratio: 1; overflow: hidden; background: var(--panel-deep); }
  .quote-body { display: grid; align-content: start; gap: 12px; padding: 22px 22px 16px; flex: 1; }
  .stars { color: var(--ginger); letter-spacing: 3px; font-size: .95rem; }
  blockquote { margin: 0; font-size: .95rem; }
  .quote figcaption { position: static; background: none; padding: 0 22px 22px; font-size: .82rem; }
  .quote figcaption b { color: var(--ink); font-weight: 600; }
  .quote--result p { font-size: .95rem; color: var(--ink-soft); }

  .voucher { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(28px, 4vw, 56px); align-items: center; }
  .v-copy { display: grid; gap: 16px; }
  .v-eyebrow { color: var(--accent); }
  .v-lead { color: var(--ink-soft); }

  .about { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .portrait { aspect-ratio: 4 / 5; max-width: 100%; border-radius: var(--radius-panel); overflow: hidden; background: var(--sunk); }
  .a-copy { display: grid; gap: 18px; }

  @media (min-width: 1101px) { .quotes { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  /* two opinions in view and the third peeking in: scroll sideways instead of wrapping 2 + 1 */
  @media (min-width: 601px) and (max-width: 1100px) {
    .quotes:has(> :nth-child(3)) {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: calc((100% - 18px) * .45);
      overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
    }
    .quotes > * { scroll-snap-align: start; }
  }
  @media (max-width: 600px) { .quotes { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .voucher, .about { grid-template-columns: 1fr; } .portrait { max-width: 340px; } }
  @media (max-width: 700px) { .gallery { grid-template-columns: repeat(2, 1fr); } }
</style>

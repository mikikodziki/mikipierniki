---
import Photo from "../Photo.astro";
import Glued from "../Glued.astro";
import { seasonFor } from "@/lib/site";
import type { Season } from "@/lib/types";

/**
 * Four photographs per season fade into one another over 32 seconds.
 * The keyframes are cut into quarters, so each season needs four shots.
 */
interface Shot { name: string; alt: string; position?: string }
const variants: { season: Season; badge: string; title: string; em: string; after: string; lead: string; shots: [Shot, Shot, Shot, Shot] }[] = [
  {
    season: "swieta",
    // the Christmas season runs 15 Sep – 31 Dec, so it always belongs to the current year
    badge: `Zapisy na sezon świąteczny ${new Date().getFullYear()} otwarte`,
    title: "Warsztaty lukrowania ", em: "pierników", after: "",
    lead: "Trzy do czterech godzin, lukier królewski i 6–8 pierników, które zabierasz do domu. Nie musisz umieć rysować. Pokażę Ci każdy ruch rękawem cukierniczym.",
    shots: [
      { name: "hero-swieta-galazki-pierniki", alt: "Świąteczne gałązki z lampkami obok piernikowych domków, misiów i bałwanków", position: "80% 50%" },
      { name: "hero-swieta-lampki-mis-choinka", alt: "Piernikowy miś w zielonym szaliku i choinka wśród gałązek ze złotymi światełkami", position: "80% 50%" },
      { name: "hero-swieta-lampki-sniezynka-kamieniczka", alt: "Piernikowa śnieżynka ze złotymi detalami i kamieniczka wśród świerkowych gałązek z lampkami", position: "80% 50%" },
      { name: "hero-swieta-lampki-mikolaj-domek", alt: "Piernikowy Mikołaj i domek z czerwonym sercem wśród świerkowych gałązek ze złotymi światełkami", position: "80% 50%" },
    ],
  },
  {
    season: "wielkanoc",
    badge: "Warsztaty wielkanocne: marzec i kwiecień",
    title: "Pisanki, które ", em: "pachną", after: " piernikiem",
    lead: "Wiosenne kolory lukru, zajączki i pisanki do koszyczka. Warsztaty dla dorosłych i osobne dla dzieci, w grupach od 4 do 10 osób.",
    shots: [
      { name: "zajaczki-trzy", alt: "Trzy piernikowe zajączki w różowych i zielonych sukienkach" },
      { name: "wielkanoc-kurczaczki", alt: "Piernikowe kurczaczki w żółtym lukrze" },
      { name: "zajac-auto", alt: "Piernikowy kabriolet z zajączkiem i bagażnikiem pełnym marchewek" },
      { name: "wielkanoc-zajaczek", alt: "Piernikowy zajączek w pastelowym lukrze" },
    ],
  },
  {
    season: "rok",
    badge: "Pierniki na urodziny, walentynki i Halloween",
    title: "Pierniki na ", em: "każdą", after: " okazję",
    lead: "Ręcznie dekorowane zestawy na prezent, podziękowania dla gości i firmowe upominki w dowolnym kształcie. A dla grup prywatne warsztaty przez cały rok.",
    shots: [
      { name: "kamieniczki", alt: "Trzy piernikowe kamieniczki zdobione lukrem i złotymi detalami" },
      { name: "gwiazdka-zlota", alt: "Piernikowa gwiazdka w białym lukrze ze złotym wzorem" },
      { name: "zajac-auto", alt: "Piernikowy kabriolet z zajączkiem i bagażnikiem pełnym marchewek" },
      { name: "kury", alt: "Piernikowe kury w kolorowym lukrze" },
    ],
  },
];
// Only the current season's first shot loads eagerly, at high priority (the LCP image); the other
// seasons stay lazy inside display:none and are never fetched. Shots 2–4 first show after ~7 s, so
// they are fetched only after the page has loaded (script below): on phones they used to compete
// with the first shot. Until they are in, the cycle holds on the first shot.
const buildSeason = seasonFor(new Date());
---
<section class="hero panel--deep">
  {variants.map((v) => (
    <div class="stage" data-for-season={v.season}>
      {v.shots.map((s, i) => (
        <div class="shot" style={`--i: ${i}`}>
          <Photo name={s.name} alt={i === 0 ? s.alt : ""} sizes="100vw" eager={i === 0 && v.season === buildSeason} deferred={i > 0} position={s.position ?? "28% 50%"} />
        </div>
      ))}
    </div>
  ))}
  <div class="scrim" aria-hidden="true"></div>
  <!-- WCAG 2.2.2: moving content that lasts over 5 s needs a way to stop it -->
  <button class="hero-pause" type="button" aria-pressed="false" aria-label="Zatrzymaj zmianę zdjęć">
    <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="2.5" width="3" height="11" rx="1" /><rect x="9.5" y="2.5" width="3" height="11" rx="1" /></svg>
    <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.8v10.4a.8.8 0 0 0 1.2.7l8.4-5.2a.8.8 0 0 0 0-1.4L5.7 2.1a.8.8 0 0 0-1.2.7Z" /></svg>
  </button>

  <div class="wrap inner">
    {variants.map((v) => (
      <div class="copy" data-for-season={v.season}>
        <span class="badge">{v.badge}</span>
        <h1>{v.title}<em>{v.em}</em>{v.after}</h1>
        <p class="lead"><Glued text={v.lead} /></p>
        <div class="actions">
          <a class="btn btn-primary" href="/warsztaty">Zobacz terminy</a>
          <a class="btn btn-ghost" href="/zamowienia">Zamów pierniki</a>
        </div>
        <p class="note"><Glued text="Pracownia we Wrocławiu · grupy 4–10 osób · wszystko w cenie" /></p>
      </div>
    ))}
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>(".hero");
  const pause = hero?.querySelector<HTMLButtonElement>(".hero-pause");

  // Two seconds after load, fetch shots 2–4 of the season on screen; the cycle starts (from the
  // first shot) once they are decoded. With reduced motion nothing cycles, so they are never fetched.
  const startCycle = () => {
    const stage = [...(hero?.querySelectorAll<HTMLElement>(".stage") ?? [])].find((s) => s.offsetParent !== null);
    const later = [...(stage?.querySelectorAll<HTMLImageElement>("img[data-srcset]") ?? [])];
    later.forEach((img) => {
      img.loading = "eager";
      img.fetchPriority = "low";
      img.srcset = img.dataset.srcset!;
      img.src = img.dataset.src!;
    });
    Promise.all(later.map((img) => img.decode())).then(
      () => hero?.setAttribute("data-ready", ""),
      () => {},
    );
  };
  if (hero && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const later = () => setTimeout(startCycle, 2000);
    if (document.readyState === "complete") later();
    else addEventListener("load", later, { once: true });
  }

  pause?.addEventListener("click", () => {
    const paused = hero!.toggleAttribute("data-paused");
    pause.setAttribute("aria-pressed", String(paused));
  });
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(560px, 80vh, 840px);
    padding-block: clamp(48px, 6vw, 88px);
    background: var(--hero-shade);
  }
  .stage { position: absolute; inset: 0; z-index: 0; }
  .shot {
    position: absolute; inset: 0; opacity: 0;
    animation: hero-shot 32s linear infinite, hero-drift 32s ease-in-out infinite;
    /* Start with the first photograph fully visible. */
    animation-delay: calc(var(--i) * 8s - 1.28s);
  }
  .shot :global(.photo) { width: 100%; height: 100%; object-fit: cover; }
  .hero:not([data-ready]) .shot, .hero[data-paused] .shot { animation-play-state: paused; }

  .hero-pause {
    position: absolute; right: 16px; bottom: 16px; z-index: 5;
    display: grid; place-items: center; width: 40px; height: 40px; padding: 0;
    border: 0; border-radius: 50%; cursor: pointer;
    color: var(--on-dark); background: color-mix(in srgb, var(--brand-deep) 58%, transparent);
    transition: background-color .18s ease;
  }
  .hero-pause:hover { background: color-mix(in srgb, var(--brand-deep) 78%, transparent); }
  .hero-pause:focus-visible { outline: 3px solid var(--on-dark); outline-offset: 2px; }
  .hero-pause svg { width: 16px; height: 16px; fill: currentColor; }
  .hero-pause .i-play, .hero-pause[aria-pressed="true"] .i-pause { display: none; }
  .hero-pause[aria-pressed="true"] .i-play { display: block; }
  /* each photo holds a quarter of the cycle, with a slow dissolve between */
  @keyframes hero-shot {
    0%   { opacity: 0; }
    4%   { opacity: 1; }
    25%  { opacity: 1; }
    29%  { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes hero-drift {
    0%   { transform: scale(1); }
    29%  { transform: scale(1.06); }
    100% { transform: scale(1); }
  }

  /* Shade the branches beneath the copy, keeping the cookies clear. */
  .scrim {
    position: absolute; inset: 0; z-index: 2;
    background:
      linear-gradient(96deg,
        color-mix(in srgb, var(--brand-deep) 72%, transparent) 0%,
        color-mix(in srgb, var(--brand-deep) 62%, transparent) 30%,
        color-mix(in srgb, var(--brand-deep) 30%, transparent) 46%,
        transparent 64%);
  }
  .inner { position: relative; z-index: 4; }
  .copy { display: grid; gap: 24px; max-width: min(560px, 45%); }

  .badge { justify-self: start; display: grid; gap: 12px; color: var(--on-dark); font-weight: 500; font-size: 0.75rem; letter-spacing: var(--caps); text-transform: uppercase; }
  .badge::after { content: ""; width: 56px; height: 1px; background: color-mix(in srgb, var(--on-dark) 55%, transparent); }

  /* Rounded, ornamental lettering for the workshop headline. */
  h1 {
    font-family: var(--hero-display);
    font-weight: 400;
    font-size: clamp(2.7rem, 5vw, 4.5rem);
    line-height: 1.14;
    letter-spacing: 0;
    color: var(--on-dark);
    text-shadow: var(--hero-text-shadow);
  }
  h1 em { font-style: normal; color: inherit; }
  .copy .lead, .copy .note { color: var(--on-dark); }
  .copy .lead, .copy .note, .badge { text-shadow: var(--hero-text-shadow); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .note { font-size: 0.75rem; letter-spacing: .06em; }

  /* narrow screens: the picture becomes a band under the copy */
  @media (max-width: 860px) {
    .hero { min-height: 0; padding-bottom: clamp(260px, 62vw, 380px); }
    .stage { top: auto; height: clamp(240px, 58vw, 360px); }
    .scrim { display: none; }
    .copy { max-width: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot { animation: none; opacity: 0; }
    .shot:first-child { opacity: 1; }
    /* nothing moves, so nothing to pause */
    .hero-pause { display: none; }
  }
</style>

---
import Photo from "../Photo.astro";
import type { CookieShape, Season } from "@/lib/types";

const variants: { season: Season; badge: string; title: string; em: string; after: string; lead: string; photo: string; photoAlt: string; shapes: [CookieShape, CookieShape, CookieShape, CookieShape] }[] = [
  {
    season: "swieta",
    badge: "Zapisy na sezon świąteczny 2026 otwarte",
    title: "Udekoruj swoje ", em: "pierwsze", after: " świąteczne pierniki",
    lead: "Trzy do czterech godzin, lukier królewski i 6–8 pierników, które zabierasz do domu. Nie musisz umieć rysować. Pokażę Ci każdy ruch rękawem cukierniczym.",
    photo: "swieta-stol", photoAlt: "Piernikowe domki, misie i bałwanki rozłożone na drewnianym stole",
    shapes: ["man", "star", "tree", "heart"],
  },
  {
    season: "wielkanoc",
    badge: "Warsztaty wielkanocne: marzec i kwiecień",
    title: "Pisanki, które ", em: "pachną", after: " piernikiem",
    lead: "Wiosenne kolory lukru, zajączki i pisanki do koszyczka. Warsztaty dla dorosłych i osobne dla dzieci, w grupach od 4 do 10 osób.",
    photo: "zajaczki-trzy", photoAlt: "Trzy piernikowe zajączki w różowych i zielonych sukienkach",
    shapes: ["egg", "heart", "egg", "star"],
  },
  {
    season: "rok",
    badge: "Pierniki na urodziny, walentynki i Halloween",
    title: "Pierniki na ", em: "każdą", after: " okazję",
    lead: "Ręcznie dekorowane zestawy na prezent, podziękowania dla gości i firmowe upominki w dowolnym kształcie. A dla grup prywatne warsztaty przez cały rok.",
    photo: "kamieniczki", photoAlt: "Trzy piernikowe kamieniczki zdobione lukrem i złotymi detalami",
    shapes: ["heart", "pumpkin", "man", "star"],
  },
];
---
<section class="hero panel--cherry">
  {variants.map((v) => (
    <div class="shot" data-for-season={v.season}>
      <Photo name={v.photo} alt={v.photoAlt} sizes="100vw" eager />
    </div>
  ))}
  <div class="veil" aria-hidden="true"></div>
  <div class="wrap inner">
    {variants.map((v) => (
      <div class="copy" data-for-season={v.season}>
        <span class="kicker">{v.badge}</span>
        <h1>{v.title}<em>{v.em}</em>{v.after}</h1>
        <p class="lead">{v.lead}</p>
        <div class="actions">
          <a class="btn btn-primary" href="/warsztaty">Zobacz terminy</a>
          <a class="btn btn-ghost" href="/zamowienia">Zamów pierniki</a>
        </div>
        <div class="where">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z" stroke-linejoin="round" />
            <circle cx="12" cy="10" r="2.6" />
          </svg>
          <p><b>Pracownia przy ul. Długiej 55 we Wrocławiu</b>Grupy od 4 do 10 osób · wszystkie materiały w cenie</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* the photo fills the whole panel; a cherry wash carries the type over it */
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(520px, 74vh, 740px);
    padding-block: clamp(40px, 6vw, 72px);
  }
  .shot { position: absolute; inset: 0; z-index: 0; }
  .veil {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(96deg,
      var(--cherry) 0 34%,
      color-mix(in srgb, var(--cherry) 92%, transparent) 44%,
      color-mix(in srgb, var(--cherry) 34%, transparent) 60%,
      transparent 74%);
  }
  .inner { position: relative; z-index: 2; }

  .copy { display: grid; gap: 22px; max-width: min(560px, 50%); }
  .kicker {
    display: flex; align-items: center; gap: 10px;
    font-size: .78rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
    color: var(--on-dark);
  }
  .kicker::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--blue); flex: none; }
  h1 { font-size: clamp(2.6rem, 6.2vw, 4.4rem); line-height: 1.02; }
  h1 em { font-style: normal; color: inherit; }
  .lead { max-width: 46ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .where {
    display: flex; gap: 12px; align-items: flex-start;
    margin-top: 6px; padding-top: 22px;
    border-top: 1px solid color-mix(in srgb, var(--on-dark) 26%, transparent);
    font-size: .84rem; color: var(--on-dark-soft);
  }
  .where svg { width: 19px; height: 19px; flex: none; margin-top: 1px; color: var(--blue); }
  .where b { display: block; color: var(--on-dark); font-weight: 600; letter-spacing: .02em; }

  /* narrow screens: the photo becomes a band under the copy, the panel does the rest */
  @media (max-width: 860px) {
    .hero { min-height: 0; padding-bottom: clamp(250px, 58vw, 350px); }
    .shot { top: auto; height: clamp(230px, 54vw, 330px); }
    .veil { display: none; }
    .copy { max-width: none; }
  }
</style>

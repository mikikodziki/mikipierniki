---
import { site } from "@/lib/site";
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
---
<footer class="foot-wrap">
  <div class="wrap">
    <div class="foot">
      <div class="brand">
        <a class="logo" href="/"><Logo label={site.name} /></a>
        <p>{site.tagline}.</p>
      </div>
      <div>
        <h2 class="h">Kontakt</h2>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><a href="/kontakt">Formularz kontaktowy</a></li>
        </ul>
      </div>
      <div>
        <h2 class="h">Na skróty</h2>
        <ul>
          <li><a href="/warsztaty">Terminy warsztatów</a></li>
          <li><a href="/warsztaty#firmy">Warsztaty dla firm</a></li>
          <li><a href="/zamowienia">Pierniki na zamówienie</a></li>
          <li><a href="/faq">FAQ</a></li>
        </ul>
      </div>
      <div>
        <h2 class="h">Obserwuj</h2>
        <ul>
          <li><a href={site.instagram} rel="noopener">Instagram</a></li>
        </ul>
      </div>
    </div>
    <div class="copy">
      <span>© {year} {site.name}</span>
      <span><a href="/regulamin">Regulamin warsztatów</a> · <a href="/polityka-prywatnosci">Polityka prywatności</a></span>
    </div>
  </div>
</footer>

<style>
  .foot-wrap { background: transparent; color: var(--on-page); padding-block: 48px 28px; }
  .foot { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 28px; }
  .brand { display: grid; gap: 12px; align-content: start; }
  .brand p { color: var(--on-page-soft); max-width: 34ch; }
  .logo { display: flex; align-items: center; text-decoration: none; color: var(--on-page); }
  .logo :global(.logo-mark) { height: 62px; width: auto; }
  .h { margin: 0 0 10px; font: 600 .78rem var(--body); letter-spacing: .12em; text-transform: uppercase; color: var(--mango); }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  a { text-decoration: none; }
  a:hover { text-decoration: underline; }
  .copy { margin-top: 40px; padding-top: 20px; border-top: 1px solid color-mix(in srgb, var(--on-page) 20%, transparent); font-size: .82rem; color: var(--on-page-soft); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; }
  @media (max-width: 760px) { .foot { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
  @media (max-width: 900px) { .foot-wrap { padding-bottom: 100px; } }
</style>

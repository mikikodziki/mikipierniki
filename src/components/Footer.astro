---
import { site } from "@/lib/site";
import Hug from "./Hug.astro";
const year = new Date().getFullYear();
---
<footer class="foot-wrap">
  <div class="wrap">
    <div class="foot">
      <div class="brand">
        <a class="logo" href="/"><Hug class="logo-mark" /><span class="logo-name">{site.name}</span></a>
        <p>{site.tagline}.</p>
      </div>
      <div>
        <h2 class="h">Kontakt</h2>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><a href="/kontakt">Formularz kontaktowy</a></li>
        </ul>
      </div>
      <div>
        <h2 class="h">Na skróty</h2>
        <ul>
          <li><a href="/warsztaty">Terminy warsztatów</a></li>
          <li><a href="/warsztaty#firmy">Warsztaty dla firm</a></li>
          <li><a href="/zamowienia">Pierniki na zamówienie</a></li>
          <li><a href="/faq">FAQ</a></li>
        </ul>
      </div>
      <div>
        <h2 class="h">Obserwuj</h2>
        <ul>
          <li><a href={site.instagram} rel="noopener">Instagram</a></li>
        </ul>
      </div>
    </div>
    <div class="copy">
      <span>© {year} {site.name}</span>
      <span><a href="/regulamin">Regulamin warsztatów</a> · <a href="/polityka-prywatnosci">Polityka prywatności</a></span>
    </div>
  </div>
</footer>

<style>
  .foot-wrap {
    max-width: var(--panel-max);
    width: 100%;
    margin: 0 auto var(--panel-gap);
    background: var(--ground);
    color: var(--ink);
    border-radius: var(--radius-panel);
    padding-block: clamp(36px, 5vw, 56px) 28px;
  }
  .foot { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 28px; }
  .brand { display: grid; gap: 12px; align-content: start; }
  .brand p { color: var(--ink-soft); max-width: 34ch; }
  .logo { display: flex; align-items: center; gap: 14px; text-decoration: none; color: var(--ink); }
  .logo-name { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.6rem; line-height: 1.05; max-width: 6ch; }
  .logo :global(.logo-mark) { height: 76px; width: auto; }
  .h { margin: 0 0 10px; font: 600 .78rem var(--body); letter-spacing: .12em; text-transform: uppercase; color: var(--ginger-text); }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  a { text-decoration: none; }
  a:hover { text-decoration: underline; }
  .copy { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); font-size: .82rem; color: var(--ink-soft); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; }
  @media (max-width: 760px) { .foot { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
  @media (max-width: 900px) { .foot-wrap { padding-bottom: 96px; } }
</style>

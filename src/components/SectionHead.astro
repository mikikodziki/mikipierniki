---
import Glued from "./Glued.astro";

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  id?: string;
}
const { eyebrow, title, lead, id } = Astro.props;
---
<div class="section-head">
  <span class="eyebrow">{eyebrow}</span>
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead"><Glued text={lead} /></p>}
  <slot />
</div>

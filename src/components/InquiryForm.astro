---
/**
 * Generic inquiry form (custom orders, private workshops, vouchers, contact).
 * Extra fields go in the default slot; any input with data-detail="<key>"
 * is sent as InquiryRequest.details[key].
 */
import type { InquiryKind } from "@/lib/types";

interface Props {
  kind: InquiryKind;
  /** Unique prefix for element ids when several forms share a page */
  id: string;
  submitLabel?: string;
  messageLabel?: string;
  messagePlaceholder?: string;
  successText?: string;
}
const {
  kind,
  id,
  submitLabel = "Wyślij zapytanie",
  messageLabel = "Wiadomość",
  messagePlaceholder = "",
  successText = "Dziękuję! Odpiszę zwykle w ciągu 24 godzin.",
} = Astro.props;
// the part of the regulamin that describes what an order or voucher request leads to
const termsHref = kind === "voucher" ? "/regulamin#vouchery" : "/regulamin#zamowienia";
---
<form class="inquiry form-grid" data-inquiry={kind} id={id} novalidate>
  <div class="row2">
    <label class="field" for={`${id}-name`}>Imię i nazwisko
      <input class="input" type="text" id={`${id}-name`} name="name" autocomplete="name" maxlength="120" required />
    </label>
    <label class="field" for={`${id}-email`}>E-mail
      <input class="input" type="email" id={`${id}-email`} name="email" autocomplete="email" required />
    </label>
  </div>
  <label class="field" for={`${id}-phone`}>Telefon <span class="hint">opcjonalnie</span>
    <input class="input" type="tel" id={`${id}-phone`} name="phone" autocomplete="tel" pattern="[0-9 +\(\)\-]{9,}" />
  </label>
  <slot />
  <label class="field" for={`${id}-message`}>{messageLabel}
    <textarea class="input" id={`${id}-message`} name="message" rows="4" maxlength="5000" placeholder={messagePlaceholder} required></textarea>
  </label>
  <label class="check" for={`${id}-consent`}><input type="checkbox" id={`${id}-consent`} name="consent" required />
    <span>Proszę o odpowiedź na to zapytanie. Jak przetwarzam dane, opisuje <a href="/polityka-prywatnosci" target="_blank">polityka prywatności</a>.</span>
  </label>
  {kind === "warsztaty-zamkniete" ? (
    <p class="inquiry-note">Zapytanie nie jest wiążące; szczegóły i cenę ustalimy w odpowiedzi.</p>
  ) : kind !== "kontakt" && (
    <p class="inquiry-note">Zapytanie nie jest wiążące; warunki {kind === "voucher" ? "voucherów" : "zamówień"} opisuje <a href={termsHref} target="_blank">regulamin</a>.</p>
  )}
  <div class="hp" aria-hidden="true"><label for={`${id}-website`}>Strona www</label><input type="text" id={`${id}-website`} name="website" tabindex="-1" autocomplete="off" /></div>
  <p class="form-error" role="alert" hidden></p>
  <div><button class="btn btn-primary" type="submit">{submitLabel}</button></div>
  <p class="form-ok" role="status" tabindex="-1" hidden>{successText}</p>
</form>

<script>
  import { ApiError, sendInquiry } from "@/lib/api";
  import { checkFields, focusFirst, liveFieldErrors, summary } from "@/lib/field-errors";
  import type { InquiryKind } from "@/lib/types";

  document.querySelectorAll<HTMLFormElement>("form[data-inquiry]").forEach((form) => {
    const err = form.querySelector<HTMLElement>(".form-error")!;
    const ok = form.querySelector<HTMLElement>(".form-ok")!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    liveFieldErrors(form);
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const consent = form.querySelector<HTMLInputElement>('input[name="consent"]')!;
      const bad = checkFields([...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(".input"), consent]);
      if (bad.length) {
        err.hidden = false;
        err.textContent = summary(bad.length);
        focusFirst(bad);
        return;
      }
      err.hidden = true;
      const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value.trim() ?? "";
      const details: Record<string, string> = {};
      form.querySelectorAll<HTMLInputElement>("[data-detail]").forEach((el) => {
        if ((el.type === "radio" || el.type === "checkbox") && !el.checked) return;
        if (el.value.trim()) details[el.dataset.detail!] = el.value.trim();
      });
      btn.disabled = true;
      try {
        await sendInquiry({ kind: form.dataset.inquiry as InquiryKind, name: val("name"), email: val("email"), phone: val("phone") || undefined, message: val("message"), details, website: val("website") });
        form.querySelectorAll<HTMLElement>(":scope > *:not(.form-ok)").forEach((el) => (el.hidden = true));
        ok.hidden = false;
        ok.focus();
      } catch (e) {
        err.hidden = false;
        err.textContent = e instanceof ApiError ? e.message : "Nie udało się wysłać wiadomości. Spróbuj ponownie albo napisz bezpośrednio na e-mail.";
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .inquiry-note { font-size: .88rem; color: var(--ink-soft); }
</style>

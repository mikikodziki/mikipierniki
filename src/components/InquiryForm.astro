---
/**
 * Generic inquiry form (custom orders, private workshops, vouchers, contact).
 * Extra fields go in the default slot; any input with data-detail="<key>"
 * is sent as InquiryRequest.details[key].
 */
import type { InquiryKind } from "@/lib/types";

interface Props {
  kind: InquiryKind;
  /** Unique prefix for element ids when several forms share a page */
  id: string;
  submitLabel?: string;
  messageLabel?: string;
  messagePlaceholder?: string;
  successText?: string;
}
const {
  kind,
  id,
  submitLabel = "Wyślij zapytanie",
  messageLabel = "Wiadomość",
  messagePlaceholder = "",
  successText = "Dziękuję! Odpiszę najpóźniej w ciągu 24 godzin.",
} = Astro.props;
---
<form class="inquiry form-grid" data-inquiry={kind} id={id} novalidate>
  <div class="row2">
    <label class="field" for={`${id}-name`}>Imię i nazwisko
      <input class="input" type="text" id={`${id}-name`} name="name" autocomplete="name" required />
    </label>
    <label class="field" for={`${id}-email`}>E-mail
      <input class="input" type="email" id={`${id}-email`} name="email" autocomplete="email" required />
    </label>
  </div>
  <label class="field" for={`${id}-phone`}>Telefon <span class="hint">opcjonalnie</span>
    <input class="input" type="tel" id={`${id}-phone`} name="phone" autocomplete="tel" />
  </label>
  <slot />
  <label class="field" for={`${id}-message`}>{messageLabel}
    <textarea class="input" id={`${id}-message`} name="message" rows="4" placeholder={messagePlaceholder} required></textarea>
  </label>
  <label class="check" for={`${id}-consent`}><input type="checkbox" id={`${id}-consent`} name="consent" required />
    <span>Zgadzam się na kontakt w sprawie zapytania zgodnie z <a href="/polityka-prywatnosci" target="_blank">polityką prywatności</a>.</span>
  </label>
  <p class="form-error" role="alert" hidden></p>
  <div><button class="btn btn-primary" type="submit">{submitLabel}</button></div>
  <p class="form-ok" role="status" hidden>{successText}</p>
</form>

<script>
  import { sendInquiry } from "@/lib/api";
  import type { InquiryKind } from "@/lib/types";

  document.querySelectorAll<HTMLFormElement>("form[data-inquiry]").forEach((form) => {
    const err = form.querySelector<HTMLElement>(".form-error")!;
    const ok = form.querySelector<HTMLElement>(".form-ok")!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      let valid = true;
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(".input").forEach((el) => {
        const good = el.checkValidity() && (!el.required || el.value.trim() !== "");
        el.setAttribute("aria-invalid", String(!good));
        if (!good) valid = false;
      });
      const consent = form.querySelector<HTMLInputElement>('input[name="consent"]')!;
      if (!valid || !consent.checked) {
        err.hidden = false;
        err.textContent = !valid ? "Uzupełnij zaznaczone pola." : "Zaznacz zgodę na kontakt, żebym mogła odpisać.";
        return;
      }
      err.hidden = true;
      const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value.trim() ?? "";
      const details: Record<string, string> = {};
      form.querySelectorAll<HTMLInputElement>("[data-detail]").forEach((el) => {
        if ((el.type === "radio" || el.type === "checkbox") && !el.checked) return;
        if (el.type === "file") { if (el.files?.length) details[el.dataset.detail!] = [...el.files].map((f) => f.name).join(", "); }
        else if (el.value.trim()) details[el.dataset.detail!] = el.value.trim();
      });
      btn.disabled = true;
      try {
        await sendInquiry({ kind: form.dataset.inquiry as InquiryKind, name: val("name"), email: val("email"), phone: val("phone") || undefined, message: val("message"), details });
        form.querySelectorAll<HTMLElement>(":scope > *:not(.form-ok)").forEach((el) => (el.hidden = true));
        ok.hidden = false;
      } catch {
        err.hidden = false;
        err.textContent = "Nie udało się wysłać wiadomości. Spróbuj ponownie albo napisz bezpośrednio na e-mail.";
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>

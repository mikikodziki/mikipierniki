---
/**
 * One custom-order category on /zamowienia: illustration placeholder,
 * description, example sets with indicative prices and the order deadline.
 */
import type { CookieShape } from "@/lib/types";
import Cookie from "../Cookie.astro";

export interface ExampleSet {
  name: string;
  note?: string;
  /** Indicative starting price, already formatted, e.g. "od 69 zł" */
  price: string;
}

interface Props {
  id: string;
  /** Value of the "Okazja" select in the order form this category preselects */
  occasion: string;
  eyebrow: string;
  title: string;
  shapes: [CookieShape, CookieShape];
  photoLabel: string;
  tile: 1 | 2 | 3 | 4;
  deadlineLead: string;
  deadline: string;
  sets: ExampleSet[];
  /** Put the picture on the right on wide screens */
  flip?: boolean;
}
const { id, occasion, eyebrow, title, shapes, photoLabel, tile, deadlineLead, deadline, sets, flip = false } = Astro.props;
---
<section class:list={["cat", { flip }]} id={id} aria-labelledby={`${id}-title`}>
  <div class="ph pic" data-label={photoLabel} style={`background: var(--tile-${tile})`}>
    <Cookie shape={shapes[0]} class="c1" />
    <Cookie shape={shapes[1]} class="c2" />
  </div>
  <div class="body">
    <span class="eyebrow">{eyebrow}</span>
    <h2 id={`${id}-title`}>{title}</h2>
    <div class="desc"><slot /></div>
    <div class="sets">
      <h3>Przykładowe zestawy</h3>
      <ul>
        {sets.map((s) => (
          <li>
            <span class="name">{s.name}{s.note && <small>{s.note}</small>}</span>
            <span class="price">{s.price}</span>
          </li>
        ))}
      </ul>
      <p class="fine">Ceny orientacyjne. Dokładną wycenę przygotuję po poznaniu projektu i liczby sztuk.</p>
    </div>
    <p class="deadline">{deadlineLead} <b>{deadline}</b></p>
    <div><a class="btn btn-primary btn-small" href="#order-form" data-occasion={occasion}>Zapytaj o wycenę</a></div>
  </div>
</section>

<style>
  .cat { display: grid; gap: 24px; scroll-margin-top: 88px; }
  .pic { aspect-ratio: 4 / 3; border-radius: var(--radius-lg); }
  .pic :global(.c1) { position: absolute; width: 44%; left: 12%; top: 14%; transform: rotate(-10deg); }
  .pic :global(.c2) { position: absolute; width: 30%; left: 56%; top: 36%; transform: rotate(12deg); }
  .body { display: grid; gap: 14px; align-content: start; min-width: 0; }
  .desc { display: grid; gap: 10px; color: var(--ink-soft); max-width: 60ch; }
  .sets { display: grid; gap: 8px; margin-top: 4px; }
  .sets h3 { font: 600 .78rem var(--body); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); }
  .sets ul { list-style: none; margin: 0; padding: 0; }
  .sets li { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding-block: 10px; border-bottom: 1px dashed var(--line); }
  .name { display: grid; min-width: 0; }
  .name small { color: var(--ink-soft); font-size: .85rem; }
  .price { font-family: var(--display); font-size: 1.15rem; white-space: nowrap; }
  .fine { font-size: .82rem; color: var(--ink-soft); }
  .deadline { font-size: .92rem; font-weight: 600; }
  .deadline b { color: var(--berry); }
  @media (min-width: 860px) {
    .cat { grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
    .cat.flip .pic { order: 2; }
  }
</style>

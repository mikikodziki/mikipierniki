---
import Panel from "@/layouts/Panel.astro";
import TermForm from "@/components/panel/TermForm.astro";
import { plural, pln, shortDate, timeRange, weekday, workshopTypeLabel } from "@/lib/format";
import { site } from "@/lib/site";
import { admitFromWaitlist, bookingsForTerm, cancelBooking, createBooking, deleteBooking, editBooking, markPaid } from "@/server/bookings";
import { bookingBlockers } from "@/server/config";
import { UserError } from "@/server/http";
import { deleteInterestRow, editInterest, interestEditFromForm, interestForTerm, notifyInterested, withdrawInterestRow } from "@/server/interest";
import { flushOutbox } from "@/server/mail";
import { back, bookingAddFromForm, bookingEditFromForm, cancelTerm, changeStatus, formStrings, statusLabel, termFromForm } from "@/server/panel";
import { deleteTerm, getTerm, publicTerms, updateTerm } from "@/server/terms";

export const prerender = false;

const id = Astro.params.id!;
const here = `/panel/termin/${id}`;

// a rejected edit is rendered again in this response, with what was typed, instead of redirecting
let formError: string | undefined;
let formValues: Record<string, string> | undefined;
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const action = String(f.get("action"));
  const booking = String(f.get("booking") ?? "");
  try {
    let ok = "Zapisano.";
    switch (action) {
      case "save":
        updateTerm(id, termFromForm(f));
        ok = "Zmiany zapisane.";
        break;
      case "propose":
        changeStatus(id, "proposed");
        ok = "Termin jest teraz propozycją widoczną na stronie.";
        break;
      case "draft":
        changeStatus(id, "draft");
        ok = "Termin wrócił do szkiców i zniknął ze strony.";
        break;
      case "open":
        changeStatus(id, "open");
        ok = "Zapisy otwarte. Teraz możesz wysłać link chętnym.";
        break;
      case "notify": {
        const n = notifyInterested(id);
        ok = n ? `Wysyłam link do rezerwacji: ${n} ${plural(n, "osoba", "osoby", "osób")}.` : "Wszyscy chętni dostali już wiadomość.";
        break;
      }
      // a date pick, keyed by interest.id; no name in the message, since it ends up in the address bar
      case "interest-edit":
        editInterest(id, Number(f.get("interest")), interestEditFromForm(f));
        ok = "Zgłoszenie poprawione.";
        break;
      case "interest-withdraw":
        withdrawInterestRow(id, Number(f.get("interest")));
        ok = "Zgłoszenie wycofane. Ten adres nie zgłosi się już na ten termin.";
        break;
      case "interest-delete":
        if (f.get("confirm") !== "on") throw new UserError("Zaznacz, że na pewno chcesz usunąć to zgłoszenie.");
        deleteInterestRow(id, Number(f.get("interest")));
        ok = "Zgłoszenie usunięte.";
        break;
      case "cancel": {
        const r = cancelTerm(id, f.get("notify") === "on");
        ok = `Termin odwołany.${r.bookings + r.interest ? ` Powiadamiam: ${r.bookings} rezerwacji, ${r.interest} chętnych.` : ""}`;
        break;
      }
      case "delete":
        if (!deleteTerm(id)) throw new UserError("Ten termin ma już zgłoszenia, więc można go tylko odwołać.");
        return back("/panel", { ok: "Termin usunięty." });
      case "paid":
        markPaid(booking);
        ok = `Rezerwacja ${booking} potwierdzona, wysyłam potwierdzenie z adresem.`;
        break;
      case "admit":
        admitFromWaitlist(booking);
        ok = `Wysyłam dane do przelewu osobie z listy rezerwowej (${booking}).`;
        break;
      case "cancel-booking":
        cancelBooking(booking, f.get("notify") === "on");
        ok = `Rezerwacja ${booking} anulowana.`;
        break;
      case "edit-booking": {
        const notify = f.get("notify") === "on";
        const r = editBooking(booking, bookingEditFromForm(f), notify);
        // nothing settles money by itself, so a changed total of a paid booking is spelled out
        const total = r.total === r.oldTotal ? "" : ` Kwota zmieniła się z ${pln(r.oldTotal)} na ${pln(r.total)}${r.paid ? ": rozlicz dopłatę albo zwrot." : "."}`;
        ok = `Rezerwacja ${booking} ${r.movedTo ? `przeniesiona na ${shortDate(r.movedTo.startsAt)}` : "poprawiona"}.${total}${notify ? " Wysyłam maila z poprawioną rezerwacją." : ""}`;
        break;
      }
      case "delete-booking":
        if (f.get("confirm") !== "on") throw new UserError("Zaznacz potwierdzenie, żeby usunąć rezerwację.");
        deleteBooking(booking);
        ok = `Rezerwacja ${booking} usunięta.`;
        break;
      case "add-booking": {
        const notify = f.get("notify") === "on";
        const r = createBooking(bookingAddFromForm(f, id), { paid: f.get("paid") === "on", notify });
        const where = r.status === "waitlist" ? "na listę rezerwową (termin jest pełny)" : r.status === "confirmed" ? "jako opłacona" : "i czeka na wpłatę";
        ok = `Rezerwacja ${r.bookingId} dodana ${where}.${notify ? " Wysyłam maila." : ""}`;
        break;
      }
      default:
        throw new UserError("Nieznana akcja.");
    }
    void flushOutbox();
    return back(here, { ok });
  } catch (e) {
    if (!(e instanceof UserError)) throw e;
    if (action !== "save") return back(here, { err: e.message });
    formError = e.message;
    formValues = formStrings(f);
    Astro.response.status = 422;
  }
}

const term = getTerm(id);
if (!term) return back("/panel", { err: "Nie ma takiego terminu." });
const interest = interestForTerm(id);
const activeInterest = interest.filter((r) => !r.withdrawn_at);
const interestPeople = activeInterest.reduce((n, r) => n + r.people, 0);
const unnotified = activeInterest.filter((r) => !r.notified_at).length;
const bookings = bookingsForTerm(id);
const taken = bookings.filter((b) => b.status === "awaiting_payment" || b.status === "confirmed").reduce((n, b) => n + b.people, 0);
const blockers = bookingBlockers();
const now = Date.now();
const dt = (iso: string | null) => (iso ? new Date(iso).toLocaleString("pl-PL", { timeZone: "Europe/Warsaw", dateStyle: "short", timeStyle: "short" }) : "");
const bookingLabel: Record<string, string> = { awaiting_payment: "Czeka na wpłatę", confirmed: "Opłacona", waitlist: "Lista rezerwowa", cancelled: "Anulowana" };
// a booking moves only to an open term that hasn't started; the panel ignores the 48-hour online window
const moveTargets = publicTerms().filter((t) => t.status === "open" && t.id !== term.id);
// the guardians field is needed whenever the booking is, or may move to, a children's workshop
const kidsPossible = term.type === "dzieci" || moveTargets.some((t) => t.type === "dzieci");
const canAdd = term.status === "open" && new Date(term.startsAt).getTime() > now;
/** The phone rule of the public forms (fields.phone) */
const PHONE = "[0-9 +\\(\\)\\-]{9,20}";
---
<Panel title={`${shortDate(term.startsAt)} · ${term.title}`}>
  <section class="box">
    <div class="actions">
      <span class={`pill pill--${term.status}`}>{statusLabel[term.status]}</span>
      <span>{weekday(term.startsAt)}, {shortDate(term.startsAt)}, {timeRange(term)} · {workshopTypeLabel[term.type]} · {pln(term.price)}</span>
    </div>
    <div class="grid3">
      <div><b>{interestPeople} os.</b><br /><span class="note">chętnych ({activeInterest.length} {plural(activeInterest.length, "zgłoszenie", "zgłoszenia", "zgłoszeń")}{interestPeople >= site.groupMin ? ", grupa się zbiera" : `, minimum to ${site.groupMin}`})</span></div>
      <div><b>{taken}/{term.capacity}</b><br /><span class="note">miejsc zajętych przez rezerwacje</span></div>
      <div><b>{bookings.filter((b) => b.status === "waitlist").length}</b><br /><span class="note">na liście rezerwowej</span></div>
    </div>

    <div class="actions">
      {term.status === "draft" && (
        <form method="post"><input type="hidden" name="action" value="propose" /><button class="btn btn-primary btn-small">Opublikuj jako propozycję</button></form>
      )}
      {(term.status === "draft" || term.status === "proposed") && (
        <form method="post"><input type="hidden" name="action" value="open" /><button class="btn btn-primary btn-small" disabled={blockers.length > 0}>Otwórz zapisy</button></form>
      )}
      {term.status === "open" && (
        <form method="post"><input type="hidden" name="action" value="notify" /><button class="btn btn-primary btn-small" disabled={unnotified === 0}>Wyślij link chętnym ({unnotified})</button></form>
      )}
      {term.status === "proposed" && activeInterest.length === 0 && (
        <form method="post"><input type="hidden" name="action" value="draft" /><button class="btn btn-ghost btn-small">Cofnij do szkicu</button></form>
      )}
      {term.status === "open" && taken === 0 && bookings.every((b) => b.status === "cancelled") && (
        <form method="post"><input type="hidden" name="action" value="propose" /><button class="btn btn-ghost btn-small">Cofnij do propozycji</button></form>
      )}
      <a class="btn btn-ghost btn-small" href={`/panel/eksport?termin=${term.id}`}>Pobierz CSV</a>
      {term.status !== "cancelled" && term.status !== "draft" && <a class="btn btn-ghost btn-small" href={term.status === "open" ? `/warsztaty?termin=${term.id}` : "/warsztaty#terminy"} target="_blank">Na stronie ↗</a>}
    </div>
    {(term.status === "draft" || term.status === "proposed") && blockers.length > 0 && (
      <p class="note">Otwarcie zapisów wymaga uzupełnienia na serwerze: {blockers.join(", ")}.</p>
    )}
  </section>

  <section class="box">
    <h2>Chętni ({activeInterest.length})</h2>
    {interest.length === 0 ? <p class="note">Nikt jeszcze nie zaznaczył tego terminu.</p> : (
      <div class="scroll">
        <table class="tbl">
          <thead><tr><th>Imię i nazwisko</th><th>Kontakt</th><th>Osób</th><th>Uwagi</th><th>Zgłoszenie</th><th>Link wysłany</th><th></th></tr></thead>
          <tbody>
            {interest.map((r) => (
              <tr class:list={{ muted: !!r.withdrawn_at }}>
                <td>{r.name}{r.withdrawn_at && <><br /><span class="pill pill--warn">wycofane</span></>}</td>
                <td><a href={`mailto:${r.email}`}>{r.email}</a>{r.phone && <><br />{r.phone}</>}</td>
                <td data-label="Osób">{r.people}</td>
                <td data-label="Uwagi">{r.notes ?? ""}</td>
                <td data-label="Zgłoszenie">{dt(r.created_at)}</td>
                <td data-label="Link wysłany">{dt(r.notified_at) || "—"}</td>
                <td>
                  <div class="actions">
                    {/* a withdrawn row was emptied on purpose, so it can only be deleted */}
                    {!r.withdrawn_at && (
                      <details>
                        <summary>Popraw</summary>
                        <form method="post" class="confirm">
                          <input type="hidden" name="action" value="interest-edit" /><input type="hidden" name="interest" value={r.id} />
                          <label class="field" for={`ie-name-${r.id}`}>Imię i nazwisko<input class="input" id={`ie-name-${r.id}`} name="name" required minlength="2" maxlength="120" value={r.name} /></label>
                          <label class="field" for={`ie-phone-${r.id}`}>Telefon <span class="hint">opcjonalnie</span><input class="input" type="tel" id={`ie-phone-${r.id}`} name="phone" pattern="[0-9 +\(\)\-]{9,20}" value={r.phone ?? ""} /></label>
                          <label class="field" for={`ie-people-${r.id}`}>Osób<input class="input" type="number" id={`ie-people-${r.id}`} name="people" required min="1" max={site.bookingMax} value={r.people} /></label>
                          <label class="field" for={`ie-notes-${r.id}`}>Uwagi<textarea class="input" id={`ie-notes-${r.id}`} name="notes" maxlength="2000">{r.notes ?? ""}</textarea></label>
                          <span class="note">Adresu e-mail nie da się zmienić. Jeśli jest błędny, usuń zgłoszenie, a ta osoba zgłosi się jeszcze raz.</span>
                          <button class="btn btn-primary btn-small">Zapisz poprawki</button>
                        </form>
                      </details>
                    )}
                    {!r.withdrawn_at && (
                      <details>
                        <summary>Wycofaj</summary>
                        <form method="post" class="confirm">
                          <input type="hidden" name="action" value="interest-withdraw" /><input type="hidden" name="interest" value={r.id} />
                          <span class="note">Tak jak wycofanie przez link z maila: telefon i uwagi znikną, a ten adres nie zgłosi się już na ten termin.</span>
                          <button class="btn btn-ghost btn-small">Wycofaj zgłoszenie</button>
                        </form>
                      </details>
                    )}
                    <details>
                      <summary>Usuń</summary>
                      <form method="post" class="confirm">
                        <input type="hidden" name="action" value="interest-delete" /><input type="hidden" name="interest" value={r.id} />
                        <label class="check" for={`idel-${r.id}`}><input type="checkbox" id={`idel-${r.id}`} name="confirm" required /><span>na pewno usuń</span></label>
                        <span class="note">Inaczej niż „Wycofaj”: po usunięciu ten adres może znów zgłosić się na ten termin.</span>
                        <button class="btn btn-ghost btn-small">Usuń zgłoszenie</button>
                      </form>
                    </details>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <section class="box">
    <h2>Rezerwacje ({bookings.filter((b) => b.status !== "cancelled").length})</h2>
    {bookings.length === 0 ? <p class="note">Brak rezerwacji.</p> : (
      <div class="scroll">
        <table class="tbl">
          <thead><tr><th>Nr</th><th>Imię i nazwisko</th><th>Kontakt</th><th>Osób</th><th>Płatność</th><th>Status</th><th>Uwagi</th><th></th></tr></thead>
          <tbody>
            {bookings.map((b) => {
              const overdue = b.status === "awaiting_payment" && b.payment_due_at && new Date(b.payment_due_at).getTime() < now;
              return (
                <tr class:list={{ muted: b.status === "cancelled" }}>
                  <td>{b.id}<br /><span class="note">{dt(b.created_at)}</span></td>
                  <td>{b.name}</td>
                  <td><a href={`mailto:${b.email}`}>{b.email}</a><br />{b.phone}</td>
                  <td data-label="Osób">{b.people}{b.guardians ? <><br /><span class="note">+ {b.guardians} rodz.</span></> : null}</td>
                  <td>{b.payment === "voucher" ? `voucher ${b.voucher_code ?? ""}` : "przelew"}<br /><b>{pln(b.total)}</b></td>
                  <td>
                    <span class:list={["pill", { "pill--ok": b.status === "confirmed", "pill--warn": overdue || b.status === "cancelled" }]}>{bookingLabel[b.status]}</span>
                    {overdue && <><br /><span class="note">termin wpłaty minął {dt(b.payment_due_at)}</span></>}
                    {b.status === "awaiting_payment" && !overdue && b.payment_due_at && <><br /><span class="note">wpłata do {dt(b.payment_due_at)}</span></>}
                  </td>
                  <td data-label="Uwagi">{b.notes ?? ""}</td>
                  <td>
                    <div class="actions">
                      {b.status === "awaiting_payment" && (
                        <form method="post"><input type="hidden" name="action" value="paid" /><input type="hidden" name="booking" value={b.id} /><button class="btn btn-primary btn-small">{b.payment === "voucher" ? "Voucher OK" : "Opłacone"}</button></form>
                      )}
                      {b.status === "waitlist" && (
                        <form method="post"><input type="hidden" name="action" value="admit" /><input type="hidden" name="booking" value={b.id} /><button class="btn btn-primary btn-small">Daj miejsce</button></form>
                      )}
                      {b.status !== "cancelled" && (
                        <details>
                          <summary>Anuluj</summary>
                          <form method="post" class="confirm">
                            <input type="hidden" name="action" value="cancel-booking" /><input type="hidden" name="booking" value={b.id} />
                            <label class="check" for={`nb-${b.id}`}><input type="checkbox" id={`nb-${b.id}`} name="notify" checked /><span>wyślij maila</span></label>
                            <button class="btn btn-ghost btn-small">Anuluj rezerwację</button>
                          </form>
                        </details>
                      )}
                      {b.status !== "cancelled" && (
                        <details>
                          <summary>Popraw</summary>
                          <form method="post" class="confirm booking-edit">
                            <input type="hidden" name="action" value="edit-booking" /><input type="hidden" name="booking" value={b.id} />
                            <label class="field" for={`ed-name-${b.id}`}>Imię i nazwisko<input class="input" id={`ed-name-${b.id}`} name="name" required minlength="2" maxlength="120" value={b.name} /></label>
                            <label class="field" for={`ed-email-${b.id}`}>E-mail<input class="input" type="email" id={`ed-email-${b.id}`} name="email" required maxlength="200" value={b.email} /></label>
                            <label class="field" for={`ed-phone-${b.id}`}>Telefon<input class="input" type="tel" id={`ed-phone-${b.id}`} name="phone" required pattern={PHONE} value={b.phone} /></label>
                            <label class="field" for={`ed-people-${b.id}`}>{term.priceUnit === "dziecko" ? "Dzieci" : "Osób"}<input class="input" type="number" id={`ed-people-${b.id}`} name="people" required min="1" max={site.bookingMax} value={b.people} /></label>
                            {kidsPossible && (
                              <label class="field" for={`ed-guardians-${b.id}`}>Rodziców <span class="hint">tylko dzieci</span><input class="input" type="number" id={`ed-guardians-${b.id}`} name="guardians" min="0" max={site.bookingMax} value={b.guardians ?? ""} /></label>
                            )}
                            <label class="field" for={`ed-notes-${b.id}`}>Uwagi<textarea class="input" id={`ed-notes-${b.id}`} name="notes" rows="2" maxlength="2000">{b.notes ?? ""}</textarea></label>
                            {moveTargets.length > 0 ? (
                              <label class="field" for={`ed-term-${b.id}`}>Termin
                                <select class="input" id={`ed-term-${b.id}`} name="termId">
                                  <option value={term.id} selected>bez zmian ({shortDate(term.startsAt)})</option>
                                  {moveTargets.map((t) => <option value={t.id}>{shortDate(t.startsAt)}, {timeRange(t)} · {t.title} · wolne: {t.seatsLeft}</option>)}
                                </select>
                              </label>
                            ) : <input type="hidden" name="termId" value={term.id} />}
                            <label class="check" for={`ed-notify-${b.id}`}><input type="checkbox" id={`ed-notify-${b.id}`} name="notify" checked /><span>wyślij maila z poprawioną rezerwacją</span></label>
                            <button class="btn btn-primary btn-small">Zapisz poprawki</button>
                          </form>
                        </details>
                      )}
                      {b.paid_at ? (
                        <span class="note">Opłaconej rezerwacji nie usuniesz: zostaje w rozliczeniach przez 6 lat.{b.status !== "cancelled" && " Możesz ją anulować albo poprawić."}</span>
                      ) : (
                        <details>
                          <summary>Usuń</summary>
                          <form method="post" class="confirm">
                            <input type="hidden" name="action" value="delete-booking" /><input type="hidden" name="booking" value={b.id} />
                            <label class="check" for={`del-${b.id}`}><input type="checkbox" id={`del-${b.id}`} name="confirm" required /><span>usuń na stałe, bez maila (np. wpisana przez pomyłkę)</span></label>
                            <button class="btn btn-ghost btn-small">Usuń rezerwację</button>
                          </form>
                        </details>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </section>

  {canAdd && (
    <section class="box">
      <h2>Dodaj rezerwację</h2>
      <p class="note">Rezerwacja przyjęta telefonicznie albo mailem, także w ostatnich 48 godzinach, gdy zapisy online są już zamknięte. Miejsca liczą się jak na stronie: gdy termin jest pełny, rezerwacja trafia na listę rezerwową.</p>
      {blockers.length > 0 ? (
        <p class="note">Najpierw uzupełnij na serwerze: {blockers.join(", ")}.</p>
      ) : (
        <form method="post" class="form-grid booking-add">
          <input type="hidden" name="action" value="add-booking" />
          <div class="grid3">
            <label class="field" for="ad-name">Imię i nazwisko<input class="input" id="ad-name" name="name" required minlength="2" maxlength="120" /></label>
            <label class="field" for="ad-email">E-mail<input class="input" type="email" id="ad-email" name="email" required maxlength="200" /></label>
            <label class="field" for="ad-phone">Telefon<input class="input" type="tel" id="ad-phone" name="phone" required pattern={PHONE} /></label>
          </div>
          <div class="grid3">
            <label class="field" for="ad-people">{term.priceUnit === "dziecko" ? "Dzieci" : "Osób"} <span class="hint">najwyżej {site.bookingMax}</span><input class="input" type="number" id="ad-people" name="people" required min="1" max={site.bookingMax} value="1" /></label>
            {term.type === "dzieci" && (
              <label class="field" for="ad-guardians">Rodziców <span class="hint">co najmniej 1</span><input class="input" type="number" id="ad-guardians" name="guardians" required min="1" max={site.bookingMax} value="1" /></label>
            )}
            <label class="field" for="ad-payment">Płatność
              <select class="input" id="ad-payment" name="payment"><option value="przelew">przelew</option><option value="voucher">voucher</option></select>
            </label>
            <label class="field" for="ad-voucher">Kod vouchera <span class="hint">przy voucherze</span><input class="input" id="ad-voucher" name="voucherCode" maxlength="40" /></label>
          </div>
          <label class="field" for="ad-notes">Uwagi<textarea class="input" id="ad-notes" name="notes" rows="2" maxlength="2000"></textarea></label>
          <label class="check" for="ad-notify"><input type="checkbox" id="ad-notify" name="notify" checked /><span>wyślij maila, jak przy zapisie na stronie (dane do przelewu, voucher albo lista rezerwowa)</span></label>
          <label class="check" for="ad-paid"><input type="checkbox" id="ad-paid" name="paid" /><span>już opłacona (wtedy mailem idzie potwierdzenie z adresem)</span></label>
          <div><button class="btn btn-primary btn-small">Dodaj rezerwację</button></div>
        </form>
      )}
    </section>
  )}

  {term.status !== "cancelled" && (
    <section class="box">
      <h2>Edytuj termin</h2>
      {term.status === "open" && taken > 0 && <p class="note">Ten termin ma rezerwacje. Jeśli zmieniasz datę albo godzinę, napisz do uczestników, bo zmiana nie wysyła maili sama.</p>}
      <TermForm term={term} submitLabel="Zapisz zmiany" values={formValues} error={formError} />
    </section>

    <section class="box">
      <h2>Odwołaj albo usuń</h2>
      <form method="post" class="actions">
        <input type="hidden" name="action" value="cancel" />
        <label class="check" for="cancel-notify"><input type="checkbox" id="cancel-notify" name="notify" checked /><span>Wyślij maila wszystkim zapisanym i chętnym</span></label>
        <button class="btn btn-ghost btn-small">Odwołaj termin</button>
      </form>
      {interest.length === 0 && bookings.length === 0 && (
        <form method="post"><input type="hidden" name="action" value="delete" /><button class="btn btn-ghost btn-small">Usuń termin (nikt się nie zapisał)</button></form>
      )}
    </section>
  )}
</Panel>


---
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import InquiryForm from "@/components/InquiryForm.astro";
import { getVenues } from "@/lib/api";
import { site } from "@/lib/site";

const venues = await getVenues();
const home = venues[0];
const homeAddress = home?.address ? `${home.address}, ${home.city}` : undefined;
// Pin the municipal address point: Google resolves the text "55J" to number 55.
const mapDestination = home?.coordinates ? `${home.coordinates.lat},${home.coordinates.lng}` : homeAddress;
const mapQuery = mapDestination ? encodeURIComponent(mapDestination) : "";
// The Google map loads only after a click: until then the browser sends Google nothing (privacy policy, section 7).
const mapSrc = `https://maps.google.com/maps?q=${mapQuery}&z=17&output=embed&hl=pl`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;

const topics = ["Warsztaty", "Warsztaty dla firm", "Zamówienie", "Voucher", "Inne"];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name,
  description: site.tagline,
  email: site.email,
  url: Astro.site?.href,
  telephone: site.phoneHref.replace("tel:", ""),
  sameAs: [site.instagram],
  ...(home && {
    address: {
      "@type": "PostalAddress",
      ...(home.address && { streetAddress: home.address }),
      addressLocality: home.city,
      addressCountry: "PL",
    },
  }),
};
---
<Base
  title="Kontakt"
  description="Napisz do Miki Pierniki: pytania o warsztaty, warsztaty dla firm, pierniki na zamówienie i vouchery. Odpowiadam w ciągu 24 godzin."
  jsonLd={jsonLd}
>
  <PageHead
    eyebrow="Kontakt"
    title="Napisz do mnie"
    lead="Pytanie o termin, warsztaty dla Twojej firmy, zestaw pierników na prezent albo voucher? Wybierz, co jest dla Ciebie wygodniejsze: formularz, e-mail albo telefon."
  />

  <section class="section contact-section">
    <div class="wrap contact">
      <div class="details">
        <dl class="channels">
          <div>
            <dt>E-mail</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Telefon</dt>
            <dd><a href={site.phoneHref}>{site.phone}</a></dd>
          </div>
          {home && (
            <div>
              <dt>Miejsce warsztatów</dt>
              <dd>{home.address && <>{home.address}<br /></>}{home.city}</dd>
            </div>
          )}
          <div>
            <dt>Obserwuj</dt>
            <dd class="socials">
              <a href={site.instagram} rel="noopener">Instagram {site.instagramHandle}</a>
            </dd>
          </div>
        </dl>
        <p class="note">
          <span>Odpisuję najpóźniej w ciągu 24 godzin, zwykle tego samego dnia. W trakcie warsztatów nie odbieram telefonu, więc jeśli się nie dodzwonisz, napisz SMS albo e-mail, na pewno oddzwonię.</span>
        </p>
      </div>

      <div class="form-box">
        <h2 class="form-title">Formularz kontaktowy</h2>
        <InquiryForm
          kind="kontakt"
          id="contact-form"
          submitLabel="Wyślij wiadomość"
          messagePlaceholder="Napisz, w czym mogę pomóc. Przy warsztatach podaj liczbę osób i preferowany termin."
        >
          <label class="field" for="contact-form-topic">Temat
            <select class="input" id="contact-form-topic" name="topic" data-detail="temat">
              {topics.map((t) => <option value={t}>{t}</option>)}
            </select>
          </label>
        </InquiryForm>
      </div>
    </div>
  </section>

  <section class="section section--sunk" id="dojazd" aria-labelledby="venues-title">
    <div class="wrap venue-layout">
      <div class="venue-copy">
        <span class="eyebrow">Gdzie się spotykamy</span>
        <h2 id="venues-title">Warsztaty we Wrocławiu</h2>
        <p class="lead">Wszystkie warsztaty otwarte prowadzę w mojej pracowni we Wrocławiu. Warsztaty dla firm i grup zamkniętych poprowadzę u siebie albo z dojazdem do Was.</p>
      </div>
      {homeAddress && (
        <div class="venue-map" data-map={mapSrc} data-map-title={`Mapa dojazdu do Miki Pierniki — ${homeAddress}`}>
          <div class="map-gate">
            <svg class="map-pin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" /></svg>
            <button class="btn btn-primary btn-small" type="button" data-map-show>Pokaż mapę</button>
            <p>Mapa Google wczyta się po kliknięciu. Wtedy Google otrzyma m.in. Twój adres IP. <a href={mapLink} target="_blank" rel="noopener">Otwórz w Google Maps</a></p>
          </div>
        </div>
      )}
    </div>
  </section>
</Base>

<script>
  document.querySelector("[data-map-show]")?.addEventListener("click", () => {
    const box = document.querySelector<HTMLElement>(".venue-map")!;
    const frame = document.createElement("iframe");
    frame.src = box.dataset.map!;
    frame.title = box.dataset.mapTitle!;
    frame.referrerPolicy = "no-referrer-when-downgrade";
    frame.allowFullscreen = true;
    box.replaceChildren(frame);
    // the button is gone: keep keyboard focus in the same place
    frame.tabIndex = 0;
    frame.focus();
  });
</script>
<style>
  .contact { display: grid; gap: 40px; }
  @media (min-width: 900px) { .contact { grid-template-columns: 0.9fr 1.1fr; gap: 64px; align-items: start; } }

  .details { display: grid; gap: 28px; }
  .channels { margin: 0; display: grid; gap: 20px; }
  .channels dt { font-size: .78rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); }
  .channels dd { margin: 4px 0 0; font-family: var(--display); font-weight: var(--display-weight); font-size: clamp(1.3rem, 3vw, 1.6rem); line-height: 1.2; overflow-wrap: anywhere; }
  .channels dd a { text-decoration-color: var(--ginger); text-underline-offset: 4px; }
  .socials { display: flex; flex-wrap: wrap; gap: 4px 20px; }

  .note { display: flex; gap: 14px; align-items: start; color: var(--ink-soft); max-width: 48ch; padding-top: 24px; border-top: 1px solid var(--line); }

  .form-box { display: grid; gap: 20px; min-width: 0; align-content: start; }
  .form-title { font-size: clamp(1.5rem, 3vw, 1.9rem); }

  #dojazd { scroll-margin-top: 88px; }
  .venue-layout { display: grid; gap: clamp(28px, 4vw, 56px); align-items: center; }
  .venue-copy { display: grid; gap: 20px; min-width: 0; }
  .venue-map { min-width: 0; width: 100%; max-width: 380px; height: 280px; justify-self: center; overflow: hidden; border-radius: var(--radius-panel); border: 1px solid var(--line); background: var(--surface); }
  .venue-map iframe { display: block; width: 100%; height: 100%; border: 0; }
  .map-gate {
    height: 100%; display: grid; place-content: center; justify-items: center; gap: 14px;
    padding: 24px; text-align: center; background: var(--panel-deep);
  }
  .map-pin { width: 34px; height: 34px; fill: var(--accent); }
  .map-gate p { font-size: .85rem; color: var(--ink-soft); max-width: 34ch; }
  .map-gate a { color: var(--ink); font-weight: 600; }
  @media (min-width: 900px) {
    .venue-layout { grid-template-columns: minmax(0, 1fr) minmax(0, 380px); }
    .venue-map { height: 300px; justify-self: end; }
  }
  @media (max-width: 480px) { .venue-map { height: 240px; } }
</style>

---
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import InquiryForm from "@/components/InquiryForm.astro";
import { getVenues } from "@/lib/api";
import { site } from "@/lib/site";

const venues = await getVenues();
const home = venues[0];

const topics = ["Warsztaty", "Warsztaty dla firm", "Zamówienie", "Voucher", "Inne"];

// Bez pola `url` — adres strony nie jest jeszcze ustalony.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name,
  description: site.tagline,
  email: site.email,
  telephone: site.phone,
  sameAs: [site.instagram],
  ...(home && {
    address: {
      "@type": "PostalAddress",
      addressLocality: home.city,
      addressCountry: "PL",
    },
  }),
};
---
<Base
  title="Kontakt"
  description="Napisz do Miki Pierniki: pytania o warsztaty, warsztaty dla firm, pierniki na zamówienie i vouchery. Odpowiadam w ciągu 24 godzin."
  jsonLd={jsonLd}
>
  <PageHead
    eyebrow="Kontakt"
    title="Napisz do mnie"
    lead="Pytanie o termin, warsztaty dla Twojej firmy, zestaw pierników na prezent albo voucher? Wybierz, co jest dla Ciebie wygodniejsze: formularz, e-mail albo telefon."
  />

  <section class="section contact-section">
    <div class="wrap contact">
      <div class="details">
        <dl class="channels">
          <div>
            <dt>E-mail</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Telefon</dt>
            <dd><a href={site.phoneHref}>{site.phone}</a></dd>
          </div>
          {home && (
            <div>
              <dt>Miejsce warsztatów</dt>
              <dd>{home.city}</dd>
            </div>
          )}
          <div>
            <dt>Obserwuj</dt>
            <dd class="socials">
              <a href={site.instagram} rel="noopener">Instagram {site.instagramHandle}</a>
            </dd>
          </div>
        </dl>
        <p class="note">
          <span>Odpisuję najpóźniej w ciągu 24 godzin, zwykle tego samego dnia. W trakcie warsztatów nie odbieram telefonu, więc jeśli się nie dodzwonisz, napisz SMS albo e-mail, na pewno oddzwonię.</span>
        </p>
      </div>

      <div class="form-box">
        <h2 class="form-title">Formularz kontaktowy</h2>
        <InquiryForm
          kind="kontakt"
          id="contact-form"
          submitLabel="Wyślij wiadomość"
          messagePlaceholder="Napisz, w czym mogę pomóc. Przy warsztatach podaj liczbę osób i preferowany termin."
        >
          <label class="field" for="contact-form-topic">Temat
            <select class="input" id="contact-form-topic" name="topic" data-detail="temat">
              {topics.map((t) => <option value={t}>{t}</option>)}
            </select>
          </label>
        </InquiryForm>
      </div>
    </div>
  </section>

  <section class="section section--sunk" aria-labelledby="venues-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Gdzie się spotykamy</span>
        <h2 id="venues-title">Warsztaty we Wrocławiu</h2>
        <p class="lead">Wszystkie warsztaty otwarte prowadzę we Wrocławiu. Dokładny adres podaję w potwierdzeniu zapisu, razem z godziną i wskazówkami dojazdu. Warsztaty dla firm i grup zamkniętych poprowadzę u siebie albo z dojazdem do Was.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; gap: 40px; }
  @media (min-width: 900px) { .contact { grid-template-columns: 0.9fr 1.1fr; gap: 64px; align-items: start; } }

  .details { display: grid; gap: 28px; }
  .channels { margin: 0; display: grid; gap: 20px; }
  .channels dt { font-size: .78rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); }
  .channels dd { margin: 4px 0 0; font-family: var(--display); font-weight: var(--display-weight); font-size: clamp(1.3rem, 3vw, 1.6rem); line-height: 1.2; overflow-wrap: anywhere; }
  .channels dd a { text-decoration-color: var(--ginger); text-underline-offset: 4px; }
  .socials { display: flex; flex-wrap: wrap; gap: 4px 20px; }

  .note { display: flex; gap: 14px; align-items: start; color: var(--ink-soft); max-width: 48ch; padding-top: 24px; border-top: 1px solid var(--line); }

  .form-box { display: grid; gap: 20px; min-width: 0; align-content: start; }
  .form-title { font-size: clamp(1.5rem, 3vw, 1.9rem); }

</style>

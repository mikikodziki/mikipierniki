---
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import SectionHead from "@/components/SectionHead.astro";
import Piping from "@/components/Piping.astro";
import FaqList from "@/components/FaqList.astro";
import InquiryForm from "@/components/InquiryForm.astro";
import TermsList from "@/components/workshops/TermsList.astro";
import SignupDialog from "@/components/workshops/SignupDialog.astro";
import InterestDialog from "@/components/workshops/InterestDialog.astro";
import VoucherCard from "@/components/VoucherCard.astro";
import { getFaq, venueById } from "@/lib/api";
import { plural, pln } from "@/lib/format";
import { legal, site, workshopDefaults } from "@/lib/site";
import type { WorkshopType } from "@/lib/types";
import { publicTerms } from "@/server/terms";

// Rendered per request: terms and seat counts come live from the database.
export const prerender = false;

const terms = publicTerms();
const anyProposed = terms.some((t) => t.status === "proposed");
const faq = [...(await getFaq("warsztaty")), ...(await getFaq("platnosci"))];

// Wszystkie warsztaty otwarte odbywają się w pracowni — adres bierzemy z danych terminu.
const studio = venueById(terms[0]?.venueId ?? "pracownia");

// Ceny warsztatów otwartych (docs/dane.md); bez terminów w kalendarzu bierzemy cennik domyślny. Voucher jest jeden, kwotowy.
const voucherPrice = site.voucherPrice;
const priceOf = (type: WorkshopType) => terms.find((t) => t.type === type)?.price ?? workshopDefaults[type].price;
const adultPrice = priceOf("dorosli");
const eveningPrice = priceOf("wieczor");
const kidsPrice = priceOf("dzieci");

const siteUrl = Astro.site?.href.replace(/\/$/, "") ?? "";
const organizer = { "@type": "Organization", name: site.name, url: siteUrl, email: site.email };

// Only confirmed (open) dates are events; proposed ones may never happen.
const jsonLd = terms.filter((t) => t.status === "open").map((t) => {
  const venue = venueById(t.venueId);
  return {
    "@context": "https://schema.org",
    "@type": "Event",
    name: `${t.title} · warsztaty lukrowania pierników`,
    description: `Warsztaty lukrowania pierników w grupie do ${t.capacity} ${plural(t.capacity, "osoby", "osób", "osób")}. Materiały w cenie, ${t.cookies} pierników zabierasz do domu.`,
    startDate: t.startsAt,
    endDate: t.endsAt,
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    location: {
      "@type": "Place",
      name: venue.name,
      address: {
        "@type": "PostalAddress",
        addressLocality: venue.city,
        addressCountry: "PL",
      },
    },
    offers: {
      "@type": "Offer",
      price: t.price,
      priceCurrency: "PLN",
      availability: t.seatsLeft > 0 ? "https://schema.org/InStock" : "https://schema.org/SoldOut",
      url: `${siteUrl}/warsztaty?termin=${t.id}`,
    },
    organizer,
    performer: { "@type": "Person", name: site.owner },
  };
});

const flow = [
  { title: "Powitanie", text: "Poznajemy się i zajmujesz miejsce przy stole. Czekają już na Ciebie upieczone przeze mnie pierniki i wszystkie materiały do lukrowania." },
  { title: "Konsystencje lukrów", text: "Pokazuję, czym różni się gęsty lukier do konturów od rzadkiego do wypełniania. Uczysz się rozpoznawać konsystencje i dobierać je do dekoracji." },
  { title: "Trzymanie rękawa i prowadzenie linii", text: "Ćwiczymy wygodny chwyt rękawa, nacisk i prowadzenie linii nad powierzchnią. Najpierw próbujesz obok piernika, żeby spokojnie oswoić ruch dłoni." },
  { title: "Kontury i kolejność lukrowania", text: "Planujemy, od których elementów zacząć i co powinno przeschnąć przed kolejną warstwą. Gęstszym lukrem obrysowujesz kształty i wyznaczasz pola do wypełnienia." },
  { title: "Wypełnianie lukrem rzadkim", text: "Rzadkim lukrem wypełniasz kontury, rozprowadzasz go do brzegów i usuwasz pęcherzyki powietrza. Pokazuję, jak uzyskać gładką, równą powierzchnię." },
  { title: "Mokre na mokrym i detale", text: "Tworzysz kropki, serduszka i marmurki w świeżym lukrze, a gdy spód przeschnie, dodajesz drobne wzory. Tu każdy piernik zaczyna wyglądać po Twojemu." },
  { title: "Pakowanie", text: "Swoje pierniki układasz w pudełku, które masz w cenie, i zabierasz do domu wszystkie. Lukier, który Ci został, też możesz wziąć ze sobą." },
  { title: "Pytania i barwienie lukrów", text: "Na koniec jest czas na Twoje pytania. Pokazuję też, jak barwić lukier i dobierać kolory, żeby łatwiej było powtórzyć dekoracje w domu." },
];

const included = [
  "pierniki, które piekę przed warsztatami, gotowe do lukrowania",
  "lukry, a ten, który Ci zostanie, zabierasz do domu",
  "rękawy cukiernicze",
  "napoje",
  "pudełko, w którym zabierasz swoje pierniki",
  "kubek rozgrzewającego ponczu korzennego (bez alkoholu) na warsztatach wieczornych",
];

const closedFacts = [
  { title: "Wycena indywidualna", text: `Pełny warsztat prowadzę dla grupy do ${site.closedGroupMax} osób. Cena zależy od liczby osób i od tego, ile czasu chcecie spędzić przy stole. Napisz, ile Was będzie, a odeślę propozycję.` },
  { title: "U mnie albo u Was", text: `Spotykamy się w mojej pracowni we ${studio.city === 'Wrocław' ? 'Wrocławiu' : studio.city} albo przyjeżdżam pod wskazany adres z kompletem materiałów.` },
  { title: "Większa grupa, krótszy cykl", text: `Przy grupach większych niż ${site.closedGroupMax} osób robimy krótsze cykle: 1–2 pierniki na osobę i rotacja grup, żeby każdy zdążył usiąść przy stole.` },
  { title: "Stanowisko do lukrowania", text: "Zamiast pełnego warsztatu mogę ustawić stanowisko do lukrowania dla chętnych. Kto ma ochotę, przysiada się i dekoruje." },
];
---
<Base
  title="Warsztaty lukrowania pierników we Wrocławiu"
  description={`Warsztaty lukrowania pierników we Wrocławiu, w mojej pracowni. Grupa od ${site.groupMin} do ${site.groupMax} osób, materiały w cenie, pierniki zabierasz do domu. Terminy dla dorosłych, wieczorne i dla dzieci, warsztaty zamknięte i vouchery.`}
  mobileCta={false}
  jsonLd={jsonLd}
>
  <PageHead
    eyebrow="Warsztaty"
    title="Kilka godzin z lukrem i pudełko pierników na wynos"
    lead={`Pracujemy w grupie od ${site.groupMin} do ${site.groupMax} osób w mojej pracowni we Wrocławiu, więc mam czas dla każdej osoby przy stole. Wszystkie materiały są w cenie, a udekorowane pierniki zabierasz do domu. Nie potrzebujesz doświadczenia, wszystkiego Cię nauczę.`}
  >
    <nav class="jump" aria-label="Na tej stronie">
      <a class="btn btn-primary" href="#terminy">Zobacz terminy</a>
      <a class="btn btn-ghost" href="#firmy">Dla firm i grup</a>
      <a class="btn btn-ghost" href="#voucher">Voucher na prezent</a>
    </nav>
  </PageHead>

  <Piping />

  <section class="section" aria-labelledby="terminy">
    <div class="wrap">
      <SectionHead
        id="terminy"
        eyebrow="Kalendarz"
        title="Wybierz termin i zarezerwuj miejsce"
        lead={`Do wyboru warsztaty dla dorosłych (3–4 godziny${adultPrice ? `, ${pln(adultPrice)} od osoby` : ""}), wieczorne, też dla dorosłych (3–4 godziny${eveningPrice ? `, ${pln(eveningPrice)} od osoby` : ""}) i dwugodzinne dla dzieci (${kidsPrice ? `${pln(kidsPrice)} za dziecko` : "dla dzieci"}). Na wieczornych podaję kubek rozgrzewającego ponczu korzennego (bez alkoholu). Wszystkie prowadzę w jednym miejscu — w mojej pracowni we Wrocławiu. Rezerwacja zajmuje minutę, a potwierdzenie przychodzi mailem.`}
      />
      <TermsList terms={terms} />
      <ul class="terms-notes">
        {anyProposed && <li>Terminy oznaczone jako propozycja dopiero zbieram. Zaznacz te, które Ci pasują, a gdy zbierze się grupa, potwierdzę termin i napiszę z linkiem do rezerwacji.</li>}
        <li>Na warsztaty dla dzieci zapraszam dzieci od 6 do 12 lat. Rodzic lub opiekun zostaje z dzieckiem przez cały czas. Młodzież od 13 do 17 lat może przyjść na warsztaty dla dorosłych bez opiekuna, z pisemną zgodą rodzica i numerem telefonu do niego. Jak dbam o bezpieczeństwo dzieci, opisują moje <a href="/standardy-ochrony-maloletnich">standardy ochrony małoletnich</a>. W sezonie mam tylko dwa terminy dla dzieci.</li>
        <li>Grupa liczy od {site.groupMin} do {site.groupMax} osób. Jeśli na dany termin zapisze się mniej niż {site.groupMin} osoby, mogę go odwołać najpóźniej {legal.lowTurnoutNoticeDays} dni wcześniej. Wtedy w ciągu 14 dni zwracam całą wpłatę albo przenoszę Cię na inny termin.</li>
        <li>Zapis wysłany przyciskiem „Rezerwuję z obowiązkiem zapłaty” jest wiążący. Płacisz przelewem w ciągu 3 dni, najpóźniej dzień przed warsztatami. Zapisy przez stronę zamykam 2 dni przed startem. Zasady rezygnacji opisuje <a href="/regulamin#rezygnacja">regulamin</a>.</li>
        <li>Każda osoba dekoruje 6–8 pierników i zabiera do domu wszystkie.</li>
      </ul>
    </div>
  </section>

  <section class="section section--sunk" aria-labelledby="przebieg">
    <div class="wrap">
      <SectionHead
        id="przebieg"
        eyebrow="Jak wygląda warsztat"
        title="Krok po kroku, od pierwszej kreski do pełnego pudełka"
        lead="Tak mniej więcej mijają nam trzy do czterech godzin na warsztatach dla dorosłych i wieczornych. Z dziećmi przechodzimy tę samą drogę w dwie godziny. Tempo dopasowuję do grupy, więc nikt nie zostaje w tyle."
      />
      <div class="flow-grid">
        <ol class="flow">
          {flow.map((s, i) => (
            <li>
              <span class="num" aria-hidden="true">{i + 1}</span>
              <div class="step">
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <aside class="included" aria-labelledby="w-cenie">
          <h3 id="w-cenie">Co jest w cenie</h3>
          <ul>
            {included.map((x) => <li>{x}</li>)}
          </ul>
          <p class="inc-note">Nie musisz niczego przynosić. Przyjdź w wygodnym ubraniu i z ochotą na odrobinę bałaganu. Alergeny w piernikach: gluten, jajka, soja, mleko (w tym laktoza). Mogą też zawierać śladowe ilości orzechów. Jeśli masz alergię lub nietolerancję, zadzwoń do mnie przed warsztatami: <a href={site.phoneHref}>{site.phone}</a>.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section" id="firmy" aria-labelledby="firmy-title">
    <div class="wrap split">
      <div class="pitch">
        <SectionHead
          id="firmy-title"
          eyebrow="Warsztaty zamknięte"
          title="Warsztaty tylko dla Twojej grupy"
          lead="Warsztaty firmowe i prywatne, tylko dla osób, które zaprosisz. Wycenę przygotowuję indywidualnie, bo zależy od liczby osób i długości warsztatu. Termin, motyw pierników i miejsce ustalamy razem."
        />
        <ul class="occasions">
          {closedFacts.map((o) => (
            <li><b>{o.title}</b><span>{o.text}</span></li>
          ))}
        </ul>
        <p class="pitch-note">Napisz, ile Was będzie, ile mamy czasu i gdzie chcecie się spotkać, a odeślę propozycję razem z wyceną.</p>
      </div>
      <div class="form-box">
        <h3>Zapytaj o termin</h3>
        <InquiryForm
          kind="warsztaty-zamkniete"
          id="firmy-form"
          messageLabel="Opowiedz coś więcej o grupie"
          messagePlaceholder="Np. zespół 10 osób, mamy jakieś dwie godziny, chcielibyśmy u nas w biurze."
          successText="Dziękuję! Odpiszę w ciągu 24 godzin z propozycją terminu i wyceną."
        >
          <div class="row2">
            <label class="field" for="firmy-form-size">Liczba osób <span class="hint">pełny warsztat do {site.closedGroupMax}</span>
              <input class="input" type="number" id="firmy-form-size" name="groupSize" data-detail="liczba_osob" min="1" inputmode="numeric" />
            </label>
            <label class="field" for="firmy-form-date">Preferowany termin
              <input class="input" type="date" id="firmy-form-date" name="preferredDate" data-detail="termin" />
            </label>
          </div>
          <div class="row2">
            <label class="field" for="firmy-form-place">Miejsce
              <select class="input" id="firmy-form-place" name="place" data-detail="miejsce">
                <option>U mnie w pracowni</option>
                <option>U Was (dojazd)</option>
              </select>
            </label>
            <label class="field" for="firmy-form-format">Formuła
              <select class="input" id="firmy-form-format" name="format" data-detail="formula">
                <option>Pełny warsztat</option>
                <option>Krótszy cykl dla większej grupy</option>
                <option>Stanowisko do lukrowania</option>
                <option>Jeszcze nie wiem</option>
              </select>
            </label>
          </div>
        </InquiryForm>
      </div>
    </div>
  </section>

  <section class="section section--dark voucher-section" id="voucher" aria-labelledby="voucher-title">
    <div class="wrap split">
      <div class="pitch">
        <SectionHead
          id="voucher-title"
          eyebrow="Voucher prezentowy"
          title="Podaruj popołudnie z lukrem"
          lead={`Voucher kosztuje ${pln(voucherPrice)} i jest ważny rok. Osoba obdarowana sama wybiera termin z kalendarza.`}
        />
        <ul class="voucher-facts">
          <li>Wystarcza na dowolne warsztaty: dla dorosłych, wieczorne albo dla dzieci. Jeśli warsztaty kosztują mniej, reszta zostaje na voucherze do końca jego ważności.</li>
          <li>Wersję PDF wysyłam mailem, a drukowaną przygotowuję do odbioru osobistego w pracowni.</li>
          <li>Realizacja jest prosta: obdarowana osoba zapisuje się na wybrany termin i przy płatności zaznacza kartę podarunkową.</li>
          <li>Formularz to niewiążąca prośba. Odpiszę osobiście i ustalimy szczegóły. Zasady opisuje <a href="/regulamin#vouchery">regulamin</a>.</li>
        </ul>
        <VoucherCard />
      </div>
      <div class="form-box voucher-order">
        <h3>Zamów voucher</h3>
        <InquiryForm
          kind="voucher"
          id="voucher-form"
          submitLabel="Zamów voucher"
          messageLabel="Dla kogo i na jaką okazję?"
          messagePlaceholder="Np. dla mamy na urodziny, najchętniej na warsztaty świąteczne."
          successText="Dziękuję! Odpiszę osobiście w ciągu 24 godzin i ustalimy szczegóły."
        >
          <div class="row2">
            <label class="field" for="voucher-form-count">Liczba voucherów
              <input class="input" type="number" id="voucher-form-count" name="count" data-detail="liczba_voucherow" min="1" value="1" inputmode="numeric" />
            </label>
            <label class="field" for="voucher-form-delivery">Forma
              <select class="input" id="voucher-form-delivery" name="delivery" data-detail="forma">
                <option>PDF mailem</option>
                <option>Drukowany, odbiór osobisty w pracowni</option>
              </select>
            </label>
          </div>
        </InquiryForm>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <SectionHead
        id="faq-title"
        eyebrow="FAQ"
        title="Pytania przed zapisem"
        lead="Nie ma tu Twojego pytania? Napisz, odpowiadam zwykle tego samego dnia."
      >
        <div><a class="btn btn-ghost btn-small" href="/kontakt">Napisz do mnie</a></div>
      </SectionHead>
      <FaqList items={faq} />
    </div>
  </section>

  <SignupDialog slot="end" terms={terms} />
  <InterestDialog slot="end" terms={terms} />
</Base>

<style>
  /* Keep anchored headings clear of the sticky header */
  section[id], .section :global(h2[id]), .section :global(form[id]) { scroll-margin-top: 88px; }
  .jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }

  .terms-notes { list-style: none; margin: 32px 0 0; padding: 0; display: grid; gap: 8px; font-size: .92rem; color: var(--ink-soft); max-width: 70ch; }
  .terms-notes li { padding-left: 16px; border-left: 3px solid var(--line); }

  /* Workshop flow: a real sequence, so it is an ordered list */
  .flow-grid { display: grid; gap: 32px; }
  .flow { list-style: none; margin: 0; padding: 0; display: grid; }
  .flow li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; position: relative; padding-bottom: 26px; }
  .flow li:not(:last-child)::before {
    content: ""; position: absolute; left: 21px; top: 46px; bottom: 4px;
    border-left: 2px dotted var(--ginger); opacity: .6;
  }
  .num {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    font-family: var(--display); font-weight: var(--display-weight); font-size: 1.35rem; color: var(--ginger-text);
    background: var(--surface); border: 1.5px solid var(--line);
  }
  .step { display: grid; gap: 6px; padding-top: 8px; }
  .step h3 { font-family: var(--body); font-weight: 700; font-size: 1.1rem; line-height: 1.3; }
  .step p { color: var(--ink-soft); font-size: .95rem; max-width: 58ch; }

  .included { display: grid; gap: 14px; align-content: start; padding: clamp(22px, 3.4vw, 34px); border-radius: var(--radius-lg); background: var(--dark); color: var(--on-dark); --focus: var(--tan); }
  .included h3 { color: var(--on-dark); }
  .included ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .included li { position: relative; padding-left: 22px; }
  .included li::before { content: ""; position: absolute; left: 4px; top: .6em; width: 8px; height: 8px; border-radius: 50%; background: var(--tan); }
  .inc-note { color: var(--on-dark-soft); font-size: .92rem; padding-top: 14px; border-top: 1px solid color-mix(in srgb, var(--on-dark) 20%, transparent); }

  @media (min-width: 900px) {
    .flow-grid { grid-template-columns: 1.4fr 1fr; gap: 56px; align-items: start; }
    .included { position: sticky; top: 96px; }
  }

  /* Private workshops and voucher: pitch next to the form */
  .split { display: grid; gap: 32px; }
  .pitch { display: grid; gap: 22px; align-content: start; min-width: 0; }
  .pitch :global(.section-head) { margin-bottom: 0; }
  .occasions { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .occasions li { display: grid; gap: 2px; padding-left: 16px; border-left: 3px solid var(--accent); }
  .occasions span { color: var(--ink-soft); font-size: .95rem; }
  .pitch-note { font-size: .95rem; max-width: 56ch; }
  .form-box { display: grid; gap: 18px; align-self: start; min-width: 0; }
  .form-box h3 { font-size: 1.6rem; }

  .voucher-facts { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; }
  .voucher-section .pitch :global(.ticket) { margin-top: clamp(20px, 3vw, 36px); }
  .voucher-section { position: relative; isolation: isolate; }
  .voucher-section::before {
    content: ""; position: absolute; inset: 0;
    z-index: -1; pointer-events: none;
    background: url("/zdjecia/szron-voucher.webp") right top / auto 100% no-repeat;
    opacity: .2;
    -webkit-mask-image: linear-gradient(90deg, transparent 65%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 65%, #000 100%);
  }
  .voucher-order {
    background: var(--ground); color: var(--ink);
    border: 1px solid var(--line); border-radius: var(--radius-panel);
  }
  .voucher-order :global(.input), .voucher-order :global(.sel) { border: 1px solid var(--field-line); box-shadow: none; }
  .voucher-order :global(.btn-primary) { background: var(--dark); color: var(--on-dark); }
  .voucher-order :global(.btn-primary:hover) { background: var(--tan); color: var(--on-tan); }

  @media (min-width: 900px) {
    .split { grid-template-columns: 1fr 1fr; gap: 56px; }
  }

  .faq-grid { display: grid; gap: 8px; }
  @media (min-width: 760px) {
    .faq-grid { grid-template-columns: 0.8fr 1.2fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  }
</style>

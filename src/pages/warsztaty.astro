---
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import SectionHead from "@/components/SectionHead.astro";
import Piping from "@/components/Piping.astro";
import Cookie from "@/components/Cookie.astro";
import FaqList from "@/components/FaqList.astro";
import InquiryForm from "@/components/InquiryForm.astro";
import TermsList from "@/components/workshops/TermsList.astro";
import SignupDialog from "@/components/workshops/SignupDialog.astro";
import { getFaq, getTerms, venueById } from "@/lib/api";
import { pln } from "@/lib/format";
import { site } from "@/lib/site";
import type { WorkshopType } from "@/lib/types";

const terms = await getTerms();
const faq = [...(await getFaq("warsztaty")), ...(await getFaq("platnosci"))];

// Wszystkie warsztaty otwarte odbywają się w pracowni — adres bierzemy z danych terminu.
const studio = venueById(terms[0]?.venueId ?? "pracownia");

// Ceny warsztatów otwartych (docs/dane.md). Voucher jest jeden, kwotowy.
const voucherPrice = site.voucherPrice;
const priceOf = (type: WorkshopType) => terms.find((t) => t.type === type)?.price;
const adultPrice = priceOf("dorosli");
const eveningPrice = priceOf("wieczor");
const kidsPrice = priceOf("dzieci");

const siteUrl = Astro.site?.href.replace(/\/$/, "") ?? "";
const organizer = { "@type": "Organization", name: site.name, url: siteUrl, email: site.email };

const jsonLd = terms.map((t) => {
  const venue = venueById(t.venueId);
  return {
    "@context": "https://schema.org",
    "@type": "Event",
    name: `${t.title} · warsztaty dekorowania pierników`,
    description: `Warsztaty dekorowania pierników lukrem w grupie od ${site.groupMin} do ${t.capacity} osób. Materiały w cenie, ${t.cookies} pierników zabierasz do domu.`,
    startDate: t.startsAt,
    endDate: t.endsAt,
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    location: {
      "@type": "Place",
      name: venue.name,
      address: {
        "@type": "PostalAddress",
        streetAddress: venue.address,
        addressLocality: venue.city,
        addressCountry: "PL",
      },
    },
    offers: {
      "@type": "Offer",
      price: t.price,
      priceCurrency: "PLN",
      availability: t.seatsLeft > 0 ? "https://schema.org/InStock" : "https://schema.org/SoldOut",
      url: `${siteUrl}/warsztaty?termin=${t.id}`,
    },
    organizer,
    performer: { "@type": "Person", name: site.owner },
  };
});

const flow = [
  { time: "ok. 15 min", title: "Powitanie i fartuch", text: "Zakładasz fartuch, nalewam coś do picia, a na stole czeka już Twoje miejsce: upieczone przeze mnie pierniki i rękawy z lukrem. Chwila na poznanie się i rozgrzanie dłoni." },
  { time: "ok. 25 min", title: "Konsystencja lukru i trzymanie rękawa", text: "Pokazuję, jak rozpoznać lukier do konturów, a jak do zalewania, i jak trzymać rękaw, żeby ręka się nie męczyła. Najpierw ćwiczysz obok piernika, dopiero potem na nim." },
  { time: "ok. 30 min", title: "Konturowanie", text: "Gęstszym lukrem obrysowujesz kształt piernika. Uczę prowadzić linię nad powierzchnią, a nie po niej, dzięki temu wychodzi równa, nawet jeśli ręka lekko drży." },
  { time: "ok. 30 min", title: "Zalewanie", text: "Rzadszym lukrem wypełniasz kontury, rozprowadzasz go do brzegów i przebijasz pęcherzyki powietrza. To moment, w którym piernik robi się gładki jak porcelana." },
  { time: "ok. 60 min", title: "Mokre na mokrym i detale", text: "Kropki, serduszka i marmurki wtopione w świeży lukier, a gdy spód trochę przeschnie — napisy i drobne wzory. Tu każdy piernik zaczyna wyglądać po Twojemu." },
  { time: "ok. 20 min", title: "Pakowanie do pudełka", text: "Swoje pierniki układasz w pudełku, które masz w cenie, i zabierasz do domu wszystkie. Lukier, który Ci został, też możesz wziąć ze sobą." },
];

const included = [
  "pierniki, które piekę przed warsztatami, gotowe do dekorowania",
  "lukry, a ten, który Ci zostanie, zabierasz do domu",
  "rękawy cukiernicze",
  "fartuch na czas warsztatów",
  "napoje",
  "pudełko, w którym zabierasz swoje pierniki",
  "lampka grzanego wina na warsztatach wieczornych",
];

const closedFacts = [
  { title: "Wycena indywidualna", text: "Cena zależy od liczby osób i od tego, ile czasu chcecie spędzić przy stole. Napisz, ile Was będzie, a odeślę propozycję." },
  { title: "U mnie albo u Was", text: `Spotykamy się w mojej pracowni (${studio.address}, ${studio.city}) albo przyjeżdżam pod wskazany adres z kompletem materiałów.` },
  { title: "Większa grupa, krótszy cykl", text: "Przy dużych grupach robimy krótsze cykle: 1–2 pierniki na osobę i rotacja grup, żeby każdy zdążył usiąść przy stole." },
  { title: "Stanowisko do lukrowania", text: "Zamiast pełnego warsztatu mogę ustawić stanowisko do lukrowania dla chętnych. Kto ma ochotę, przysiada się i dekoruje." },
];
---
<Base
  title="Warsztaty dekorowania pierników"
  description={`Warsztaty dekorowania pierników w pracowni przy ${studio.addressLocative ?? studio.address} we Wrocławiu. Grupa od ${site.groupMin} do ${site.groupMax} osób, materiały w cenie, pierniki zabierasz do domu. Terminy dla dorosłych, wieczorne z winem i dla dzieci, warsztaty zamknięte i vouchery.`}
  mobileCta={false}
  jsonLd={jsonLd}
>
  <PageHead
    eyebrow="Warsztaty"
    title="Kilka godzin z lukrem i pudełko pierników na wynos"
    lead={`Pracujemy w grupie od ${site.groupMin} do ${site.groupMax} osób w mojej pracowni przy ${studio.addressLocative ?? studio.address} we Wrocławiu, więc mam czas dla każdej osoby przy stole. Wszystkie materiały są w cenie, a udekorowane pierniki zabierasz do domu. Nie potrzebujesz doświadczenia, wszystkiego Cię nauczę.`}
  >
    <nav class="jump" aria-label="Na tej stronie">
      <a class="btn btn-primary" href="#terminy">Zobacz terminy</a>
      <a class="btn btn-ghost" href="#firmy">Dla firm i grup</a>
      <a class="btn btn-ghost" href="#voucher">Voucher na prezent</a>
    </nav>
  </PageHead>

  <Piping />

  <section class="section" aria-labelledby="terminy">
    <div class="wrap">
      <SectionHead
        id="terminy"
        eyebrow="Kalendarz"
        title="Wybierz termin i zarezerwuj miejsce"
        lead={`Do wyboru warsztaty dla dorosłych (3–4 godziny${adultPrice ? `, ${pln(adultPrice)} od osoby` : ""}), wieczorne z lampką grzanego wina (3–4 godziny${eveningPrice ? `, ${pln(eveningPrice)} od osoby` : ""}, od 18 lat) i dwugodzinne dla dzieci (${kidsPrice ? `${pln(kidsPrice)} za dziecko` : "dla dzieci"}). Wszystkie prowadzę w jednym miejscu — w mojej pracowni przy ${studio.addressLocative ?? studio.address} we Wrocławiu. Rezerwacja zajmuje minutę, a potwierdzenie przychodzi mailem.`}
      />
      <!-- DO UZUPEŁNIENIA: prawdziwy grafik terminów i liczba wolnych miejsc (terminy w mock-data są przykładowe) -->
      <TermsList terms={terms} />
      <ul class="terms-notes">
        <li>Na warsztaty dla dzieci zapraszam dzieci od 6 do 12 lat razem z rodzicem. Starsze dzieci radzą sobie same i mogą przyjść bez opiekuna. W sezonie mam tylko dwa takie terminy.</li>
        <li>Grupa liczy od {site.groupMin} do {site.groupMax} osób. Jeśli na dany termin zapisze się mniej niż {site.groupMin} osoby, mogę go odwołać — wtedy zwracam całą wpłatę albo przenoszę Cię na inny termin.</li>
        <li>Każda osoba dekoruje 6–8 pierników i zabiera do domu wszystkie.</li>
      </ul>
    </div>
  </section>

  <section class="section section--sunk" aria-labelledby="przebieg">
    <div class="wrap">
      <SectionHead
        id="przebieg"
        eyebrow="Jak wygląda warsztat"
        title="Krok po kroku, od pierwszej kreski do pełnego pudełka"
        lead="Tak mniej więcej mijają nam trzy do czterech godzin na warsztatach dla dorosłych i wieczornych. Z dziećmi przechodzimy tę samą drogę w dwie godziny. Tempo dopasowuję do grupy, więc nikt nie zostaje w tyle."
      />
      <div class="flow-grid">
        <ol class="flow">
          {flow.map((s, i) => (
            <li>
              <span class="num" aria-hidden="true">{i + 1}</span>
              <div class="step">
                <h3>{s.title} <span class="time">{s.time}</span></h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <aside class="included" aria-labelledby="w-cenie">
          <Cookie shape="star" class="inc-cookie" />
          <h3 id="w-cenie">Co jest w cenie</h3>
          <ul>
            {included.map((x) => <li>{x}</li>)}
          </ul>
          <p class="inc-note">Nie musisz niczego przynosić. Przyjdź w wygodnym ubraniu i z ochotą na odrobinę bałaganu. Pierniki zawierają gluten, jajka, soję i laktozę, mogą też zawierać śladowe ilości orzechów — alergie wpisz w formularzu zapisu.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section" id="firmy" aria-labelledby="firmy-title">
    <div class="wrap split">
      <div class="pitch">
        <SectionHead
          id="firmy-title"
          eyebrow="Warsztaty zamknięte"
          title="Warsztaty tylko dla Twojej grupy"
          lead="Warsztaty firmowe i prywatne, tylko dla osób, które zaprosisz. Wycenę przygotowuję indywidualnie, bo zależy od liczby osób i długości warsztatu. Termin, motyw pierników i miejsce ustalamy razem."
        />
        <ul class="occasions">
          {closedFacts.map((o) => (
            <li><b>{o.title}</b><span>{o.text}</span></li>
          ))}
        </ul>
        <p class="pitch-note">Napisz, ile Was będzie, ile mamy czasu i gdzie chcecie się spotkać, a odeślę propozycję razem z wyceną.</p>
      </div>
      <div class="form-box card">
        <h3>Zapytaj o termin</h3>
        <InquiryForm
          kind="warsztaty-zamkniete"
          id="firmy-form"
          messageLabel="Opowiedz coś więcej o grupie"
          messagePlaceholder="Np. zespół 14 osób, mamy jakieś dwie godziny, chcielibyśmy u nas w biurze."
          successText="Dziękuję! Odpiszę w ciągu 24 godzin z propozycją terminu i wyceną."
        >
          <!-- DO UZUPEŁNIENIA: maksymalna wielkość grupy na warsztatach zamkniętych -->
          <div class="row2">
            <label class="field" for="firmy-form-size">Liczba osób
              <input class="input" type="number" id="firmy-form-size" name="groupSize" data-detail="liczba_osob" min="1" inputmode="numeric" />
            </label>
            <label class="field" for="firmy-form-date">Preferowany termin
              <input class="input" type="date" id="firmy-form-date" name="preferredDate" data-detail="termin" />
            </label>
          </div>
          <div class="row2">
            <label class="field" for="firmy-form-place">Miejsce
              <select class="input" id="firmy-form-place" name="place" data-detail="miejsce">
                <option>U mnie w pracowni</option>
                <option>U Was (dojazd)</option>
              </select>
            </label>
            <label class="field" for="firmy-form-format">Formuła
              <select class="input" id="firmy-form-format" name="format" data-detail="formula">
                <option>Pełny warsztat</option>
                <option>Krótszy cykl dla większej grupy</option>
                <option>Stanowisko do lukrowania</option>
                <option>Jeszcze nie wiem</option>
              </select>
            </label>
          </div>
        </InquiryForm>
      </div>
    </div>
  </section>

  <section class="section section--sunk" id="voucher" aria-labelledby="voucher-title">
    <div class="wrap split">
      <div class="pitch">
        <SectionHead
          id="voucher-title"
          eyebrow="Voucher prezentowy"
          title="Podaruj popołudnie z lukrem"
          lead={`Voucher kosztuje ${pln(voucherPrice)} i jest ważny rok. Osoba obdarowana sama wybiera termin z kalendarza.`}
        />
        <ul class="voucher-facts">
          <li>Wystarcza na dowolne warsztaty: dla dorosłych, wieczorne z winem albo dla dzieci.</li>
          <li>Wersję PDF wysyłam mailem, więc sprawdza się nawet na ostatnią chwilę.</li>
          <li>Wersję drukowaną przygotowuję wyłącznie do odbioru osobistego w pracowni.</li>
          <li>Realizacja jest prosta: obdarowana osoba zapisuje się na wybrany termin i przy płatności zaznacza kartę podarunkową.</li>
        </ul>
        <div class="ticket" aria-hidden="true">
          <small>Voucher · warsztaty</small>
          <b>{site.name}</b>
          <small>{pln(voucherPrice)} · ważny rok</small>
        </div>
      </div>
      <div class="form-box card">
        <h3>Zamów voucher</h3>
        <InquiryForm
          kind="voucher"
          id="voucher-form"
          submitLabel="Zamawiam voucher"
          messageLabel="Dla kogo i na jaką okazję?"
          messagePlaceholder="Np. dla mamy na urodziny, najchętniej na warsztaty świąteczne."
          successText="Dziękuję! W ciągu 24 godzin wyślę dane do płatności, a po wpłacie voucher."
        >
          <div class="row2">
            <label class="field" for="voucher-form-count">Liczba voucherów
              <input class="input" type="number" id="voucher-form-count" name="count" data-detail="liczba_voucherow" min="1" value="1" inputmode="numeric" />
            </label>
            <label class="field" for="voucher-form-delivery">Forma
              <select class="input" id="voucher-form-delivery" name="delivery" data-detail="forma">
                <option>PDF mailem</option>
                <option>Drukowany, odbiór osobisty w pracowni</option>
              </select>
            </label>
          </div>
        </InquiryForm>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <SectionHead
        id="faq-title"
        eyebrow="FAQ"
        title="Pytania przed zapisem"
        lead="Nie ma tu Twojego pytania? Napisz, odpowiadam zwykle tego samego dnia."
      >
        <div><a class="btn btn-ghost btn-small" href="/kontakt">Napisz do mnie</a></div>
      </SectionHead>
      <FaqList items={faq} />
    </div>
  </section>

  <SignupDialog slot="end" terms={terms} />
</Base>

<style>
  /* Keep anchored headings clear of the sticky header */
  section[id], .section :global(h2[id]), .section :global(form[id]) { scroll-margin-top: 88px; }
  .jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }

  .terms-notes { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: .92rem; color: var(--ink-soft); max-width: 70ch; }
  .terms-notes li { padding-left: 16px; border-left: 3px solid var(--line); }

  /* Workshop flow: a real sequence, so it is an ordered list */
  .flow-grid { display: grid; gap: 32px; }
  .flow { list-style: none; margin: 0; padding: 0; display: grid; }
  .flow li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; position: relative; padding-bottom: 26px; }
  .flow li:not(:last-child)::before {
    content: ""; position: absolute; left: 21px; top: 46px; bottom: 4px;
    border-left: 2px dotted var(--ginger); opacity: .6;
  }
  .num {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    font-family: var(--display); font-size: 1.35rem; color: var(--ginger-text);
    background: var(--surface); border: 1.5px solid var(--line);
  }
  .step { display: grid; gap: 6px; padding-top: 8px; }
  .step h3 { font-family: var(--body); font-weight: 700; font-size: 1.1rem; line-height: 1.3; }
  .time { font-weight: 500; font-size: .82rem; color: var(--ink-soft); white-space: nowrap; margin-left: 4px; }
  .step p { color: var(--ink-soft); font-size: .95rem; max-width: 58ch; }

  .included { position: relative; display: grid; gap: 14px; align-content: start; padding: 26px; border-radius: var(--radius-lg); background: var(--surface); border: 1.5px dashed var(--ginger); }
  .included :global(.inc-cookie) { position: absolute; width: 58px; right: 18px; top: -22px; transform: rotate(12deg); }
  .included h3 { padding-right: 60px; }
  .included ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .included li { position: relative; padding-left: 22px; }
  .included li::before { content: ""; position: absolute; left: 4px; top: .6em; width: 8px; height: 8px; border-radius: 50%; background: var(--ginger); }
  .inc-note { color: var(--ink-soft); font-size: .92rem; padding-top: 12px; border-top: 1px dashed var(--line); }

  @media (min-width: 900px) {
    .flow-grid { grid-template-columns: 1.4fr 1fr; gap: 56px; align-items: start; }
    .included { position: sticky; top: 96px; }
  }

  /* Private workshops and voucher: pitch next to the form */
  .split { display: grid; gap: 32px; }
  .pitch { display: grid; gap: 22px; align-content: start; min-width: 0; }
  .pitch :global(.section-head) { margin-bottom: 0; }
  .occasions { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .occasions li { display: grid; gap: 2px; padding-left: 16px; border-left: 3px solid var(--accent); }
  .occasions span { color: var(--ink-soft); font-size: .95rem; }
  .pitch-note { font-size: .95rem; max-width: 56ch; }
  .form-box { display: grid; gap: 18px; padding: clamp(20px, 4vw, 32px); align-self: start; min-width: 0; }
  .form-box h3 { font-size: 1.6rem; }

  .voucher-facts { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; }
  .ticket {
    justify-self: start; width: calc(100% - 28px); max-width: 320px; aspect-ratio: 16 / 10; margin: 8px 14px 0;
    display: grid; align-content: space-between; padding: 22px;
    background: var(--surface); color: var(--ink); border: 1.5px dashed var(--ginger); border-radius: 16px;
    transform: rotate(-3deg); box-shadow: 0 18px 30px var(--shadow-cookie); position: relative;
  }
  .ticket::before, .ticket::after { content: ""; position: absolute; top: 50%; width: 22px; height: 22px; margin-top: -11px; border-radius: 50%; background: var(--sunk); }
  .ticket::before { left: -12px; }
  .ticket::after { right: -12px; }
  .ticket b { font-family: var(--display); font-weight: 400; font-size: 1.5rem; }
  .ticket small { font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); }

  @media (min-width: 900px) {
    .split { grid-template-columns: 1fr 1fr; gap: 56px; }
  }

  .faq-grid { display: grid; gap: 8px; }
  @media (min-width: 760px) {
    .faq-grid { grid-template-columns: 0.8fr 1.2fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  }
</style>

---
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import SectionHead from "@/components/SectionHead.astro";
import Piping from "@/components/Piping.astro";
import Cookie from "@/components/Cookie.astro";
import FaqList from "@/components/FaqList.astro";
import InquiryForm from "@/components/InquiryForm.astro";
import OrderCategory from "@/components/zamowienia/OrderCategory.astro";
import { getFaq, venueById } from "@/lib/api";
import { pln } from "@/lib/format";
import { site } from "@/lib/site";

const faq = await getFaq("zamowienia");
const studio = venueById("pracownia");

/*
 * CENNIK Z docs/dane.md. Cena zależy od wielkości piernika i trudności zdobienia,
 * więc jest wspólna dla wszystkich okazji. Zmieniaj tylko tutaj.
 */
const priceList = [
  { name: "Mały piernik", note: "np. gwiazdka", price: 15 },
  { name: "Średni piernik", price: 25 },
  { name: "Duży piernik", price: 35 },
  { name: "Zestaw w pudełku", note: "1 duży, 2 średnie i 3 małe", price: 120 },
];

const minOrder = 100;
const customFrom = 1500;
const depositPct = 15;
const parcelSmall = 12;
const parcelLarge = 20;

const steps = [
  { title: "Zapytanie", text: "Wypełniasz formularz poniżej: okazja, liczba sztuk, termin odbioru i to, co Ci się podoba. Możesz dołączyć zdjęcie inspiracji albo plik z logo." },
  { title: "Projekt i wycena", text: "Odpisuję z propozycją wzorów i wyceną. Przy własnym kształcie przygotowuję foremkę pod Twój projekt i najpierw potwierdzam z Tobą, jak piernik ma wyglądać." },
  // DO UZUPEŁNIENIA: zasady przedpłaty przy zamówieniach detalicznych (zadatek 15% dotyczy zamówień firmowych z personalizacją)
  { title: "Potwierdzenie terminu", text: `Zamówienia firmowe z personalizacją rezerwuję po wpłacie zadatku w wysokości ${depositPct}% wyceny. Od tej chwili Twoje pierniki mają swoje miejsce w moim kalendarzu pieczenia.` },
  { title: "Odbiór lub wysyłka", text: `Odbierasz pierniki w mojej pracowni (${studio.address}, ${studio.city}) albo wysyłam je Paczkomatem: mała paczka ${pln(parcelSmall)}, duża ${pln(parcelLarge)}.` },
];

const personalizacja = [
  { title: "Wysyłasz pomysł", text: "Opis albo zdjęcie inspiracji: logo, opakowanie produktu, budynek, firmowa maskotka, rysunek dziecka." },
  { title: "Robię foremkę", text: "Pod ten konkretny kształt przygotowuję własną foremkę, więc piernik nie musi być gwiazdką ani sercem." },
  { title: "Pieczemy i dekorujemy", text: "Pierniki wychodzą dokładnie w Twoim kształcie, a lukrem odwzorowuję kolory i detale z projektu." },
];

const occasions = [
  "Boże Narodzenie",
  "Wielkanoc",
  "Urodziny",
  "Walentynki",
  "Halloween",
  "Chrzciny lub komunia",
  "Ślub i wesele",
  "Zamówienie firmowe z personalizacją",
  "Inna okazja",
];
---
<Base
  title="Pierniki na zamówienie"
  description={`Ręcznie dekorowane pierniki na zamówienie we Wrocławiu: na Boże Narodzenie, Wielkanoc, urodziny, śluby i dla firm, z własnym kształtem i logo. Mały ${pln(15)}, średni ${pln(25)}, duży ${pln(35)}. Odbiór osobisty albo Paczkomat.`}
>
  <!-- DO UZUPEŁNIENIA: ostateczny termin przyjmowania zamówień wielkanocnych -->
  <PageHead
    eyebrow="Na zamówienie"
    title="Pierniki na zamówienie"
    lead="Każdy piernik piekę i dekoruję ręcznie, od pierwszej kreski lukru do wstążki na pudełku. Na prezent, na świąteczny stół, dla gości weselnych albo klientów Twojej firmy. Kształt może być dowolny — pod nietypowy projekt robię własne foremki."
  >
    <p class="season-note" data-for-season="swieta">Sezon świąteczny: zamówienia detaliczne przyjmuję do 18 grudnia, a firmowe najpóźniej dwa tygodnie przed odbiorem.</p>
    <p class="season-note" data-for-season="wielkanoc">Wielkanoc: napisz z wyprzedzeniem, a zamówienia firmowe przyjmuję najpóźniej dwa tygodnie przed odbiorem.</p>
    <p class="season-note" data-for-season="rok">Zamówienia firmowe przyjmuję najpóźniej dwa tygodnie przed odbiorem. Przy pozostałych napisz, na kiedy potrzebujesz pierników, a powiem Ci, czy zdążę.</p>
    <nav class="jump" aria-label="Kategorie zamówień">
      <a class="chip" href="#swieta">Boże Narodzenie</a>
      <a class="chip" href="#wielkanoc">Wielkanoc</a>
      <a class="chip" href="#okazje">Okazje</a>
      <a class="chip" href="#personalizacja">Własny kształt</a>
      <a class="chip" href="#cennik">Cennik</a>
      <a class="chip" href="#jak-zamowic">Jak zamówić</a>
    </nav>
  </PageHead>

  <Piping />

  <div class="section">
    <div class="wrap cats">
      <OrderCategory
        id="swieta"
        occasion="Boże Narodzenie"
        eyebrow="Boże Narodzenie"
        title="Świąteczne pierniki w pudełkach"
        shapes={["tree", "star"]}
        tile={2}
        photoLabel="zdjęcie: otwarte pudełko z choinkami i gwiazdkami na lnianym obrusie"
        deadlineLead="Zamówienia detaliczne na święta przyjmuję do"
        deadline="18 grudnia"
      >
        <p>Choinki, gwiazdki, bałwanki, domki i zawieszki na choinkę. Klasycznie w bieli albo w kolorach, które pasują do Twojego stołu.</p>
        <p>Świetnie sprawdzają się jako prezent dla nauczycielki, sąsiadów czy całego zespołu. Zamówienia firmowe przyjmuję najpóźniej dwa tygodnie przed odbiorem.</p>
      </OrderCategory>

      <!-- DO UZUPEŁNIENIA: ostateczny termin przyjmowania zamówień wielkanocnych (kategoria bez daty) -->
      <OrderCategory
        id="wielkanoc"
        occasion="Wielkanoc"
        eyebrow="Wielkanoc"
        title="Pisanki, zajączki i baranki"
        shapes={["egg", "heart"]}
        tile={4}
        photoLabel="zdjęcie: pastelowe piernikowe pisanki w wiklinowym koszyczku"
        flip
      >
        <p>Wiosenne pastele, kropki, kwiatki i koronkowe wzory. Do koszyczka, jako winietki z imionami gości albo drobny upominek na świąteczny stół.</p>
      </OrderCategory>

      <OrderCategory
        id="okazje"
        occasion="Inna okazja"
        eyebrow="Okazje przez cały rok"
        title="Na urodziny, śluby i dla firm"
        shapes={["heart", "pumpkin"]}
        tile={3}
        photoLabel="zdjęcie: pierniki z imionami gości ułożone przy nakryciach na weselnym stole"
        deadlineLead="Zamówienia firmowe przyjmuję"
        deadline="najpóźniej 2 tygodnie przed odbiorem"
      >
        <p>Urodziny, walentynki, Halloween, chrzciny, komunie i śluby. Pierniki z imionami, datą, motywem przyjęcia albo w kolorach dekoracji sali.</p>
        <p>Dla firm robię pierniki z personalizacją: z logo, w kształcie produktu albo firmowej maskotki. Jak to działa, opisuję niżej.</p>
      </OrderCategory>
    </div>
  </div>

  <section class="section section--sunk" id="personalizacja" aria-labelledby="personalizacja-title">
    <div class="wrap split">
      <div class="ph pic" data-label="zdjęcie: pierniki w kształcie firmowego logo obok foremki zrobionej na zamówienie" style="background: var(--tile-1)">
        <Cookie shape="star" class="c1" />
        <Cookie shape="man" class="c2" />
      </div>
      <div class="pitch">
        <SectionHead
          id="personalizacja-title"
          eyebrow="Personalizacja"
          title="Piernik w dowolnym kształcie, także Twojego logo"
          lead="Wystarczy, że wyślesz mi opis albo zdjęcie inspiracji. Robię wtedy własne foremki i piekę pierniki dokładnie w tym kształcie, którego potrzebujesz."
        />
        <ol class="persona">
          {personalizacja.map((p, i) => (
            <li>
              <span class="pnum" aria-hidden="true">{i + 1}</span>
              <div>
                <b>{p.title}</b>
                <span>{p.text}</span>
              </div>
            </li>
          ))}
        </ol>
        <ul class="shapes" aria-label="Przykładowe kształty">
          <li>logo firmy</li>
          <li>produkt</li>
          <li>budynek</li>
          <li>maskotka firmowa</li>
        </ul>
        <p class="persona-price">
          Zamówienia firmowe z personalizacją i własnym kształtem przyjmuję od <b>{pln(customFrom)}</b>,
          z zadatkiem {depositPct}% przy potwierdzeniu terminu.
        </p>
        <div><a class="btn btn-primary btn-small" href="#order-form" data-occasion="Zamówienie firmowe z personalizacją">Opisz swój pomysł</a></div>
      </div>
    </div>
  </section>

  <section class="section" id="cennik" aria-labelledby="cennik-title">
    <div class="wrap price-grid">
      <SectionHead
        id="cennik-title"
        eyebrow="Cennik"
        title="Ile kosztują pierniki na zamówienie"
        lead="Cena zależy od wielkości piernika i od tego, jak pracochłonne jest zdobienie. Dokładną wycenę przygotuję, gdy poznam projekt i liczbę sztuk."
      />
      <div class="price-box card">
        <ul class="prices">
          {priceList.map((p) => (
            <li>
              <span class="name">{p.name}{p.note && <small>{p.note}</small>}</span>
              <span class="price">{pln(p.price)}</span>
            </li>
          ))}
        </ul>
        <ul class="price-notes">
          <li>Minimalne zamówienie detaliczne: <b>{pln(minOrder)}</b>.</li>
          <li>Zamówienia firmowe z personalizacją i własnym kształtem: <b>od {pln(customFrom)}</b>, zadatek {depositPct}%.</li>
          <li>Odbiór osobisty w mojej pracowni przy {studio.addressLocative ?? studio.address} we Wrocławiu albo wysyłka Paczkomatem: mała paczka {pln(parcelSmall)}, duża {pln(parcelLarge)}.</li>
          <li>Pierniki zawierają gluten, jajka, soję i laktozę, mogą też zawierać śladowe ilości orzechów.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--sunk" id="jak-zamowic" aria-labelledby="jak-zamowic-title">
    <div class="wrap">
      <SectionHead
        id="jak-zamowic-title"
        eyebrow="Jak zamówić"
        title="Od pomysłu do pudełka w czterech krokach"
      />
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="wycena-title">
    <div class="wrap split">
      <div class="pitch">
        <SectionHead
          id="wycena-title"
          eyebrow="Wycena"
          title="Opowiedz mi o swoich piernikach"
          lead="Im więcej szczegółów, tym szybciej przygotuję projekt i dokładną wycenę. Odpisuję w ciągu 24 godzin."
        />
        <ul class="tips">
          <li><b>Okazja i data odbioru</b> pomagają mi zaplanować pieczenie i suszenie lukru, które trwa kilka dni.</li>
          <li><b>Liczba sztuk</b> nie musi być ostateczna, wystarczy przybliżona.</li>
          <li><b>Zdjęcie inspiracji albo logo</b> mówi więcej niż opis — na tej podstawie robię foremkę pod Twój kształt.</li>
        </ul>
        <p class="contact">Wolisz napisać bezpośrednio? <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div class="form-box card">
        <h3>Poproś o wycenę</h3>
        <InquiryForm
          kind="zamowienie"
          id="order-form"
          submitLabel="Poproś o wycenę"
          messageLabel="Opisz swoje wymarzone pierniki"
          messagePlaceholder="Np. 40 pierników na wesele, z inicjałami pary młodej, w bieli i szałwiowej zieleni."
          successText="Dziękuję! W ciągu 24 godzin odpiszę z propozycją projektu i wyceną."
        >
          <div class="row2">
            <label class="field" for="order-form-occasion">Okazja
              <select class="input" id="order-form-occasion" name="occasion" data-detail="okazja">
                {occasions.map((o) => <option>{o}</option>)}
              </select>
            </label>
            <label class="field" for="order-form-qty">Liczba sztuk
              <input class="input" type="number" id="order-form-qty" name="quantity" data-detail="liczba_sztuk" min="1" max="2000" inputmode="numeric" />
            </label>
          </div>
          <div class="row2">
            <label class="field" for="order-form-date">Data odbioru
              <input class="input" type="date" id="order-form-date" name="pickupDate" data-detail="data_odbioru" />
            </label>
            <label class="field" for="order-form-theme">Motyw i kolory
              <input class="input" type="text" id="order-form-theme" name="theme" data-detail="motyw" placeholder="Np. zimowy las, biel i złoto" />
            </label>
          </div>
          <label class="check" for="order-form-custom">
            <input type="checkbox" id="order-form-custom" name="custom" data-detail="personalizacja" value="tak, własny kształt i foremka na zamówienie" />
            <span>Chcę pierniki w niestandardowym kształcie: logo, produkt, budynek albo maskotka.</span>
          </label>
          <label class="field" for="order-form-files">Zdjęcie inspiracji albo logo <span class="hint">opcjonalnie, na tej podstawie robię foremkę</span>
            <input class="input file" type="file" id="order-form-files" name="inspiration" data-detail="inspiracja" accept="image/*" multiple />
          </label>
        </InquiryForm>
      </div>
    </div>
  </section>

  <section class="section section--sunk" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <SectionHead
        id="faq-title"
        eyebrow="FAQ"
        title="Pytania o zamówienia"
        lead="Nie ma tu Twojego pytania? Napisz, odpowiadam zwykle tego samego dnia."
      />
      <FaqList items={faq} />
    </div>
  </section>
</Base>

<script>
  // "Zapytaj o wycenę" in a category preselects that occasion in the order form.
  const select = document.getElementById("order-form-occasion") as HTMLSelectElement | null;
  const custom = document.getElementById("order-form-custom") as HTMLInputElement | null;
  document.querySelectorAll<HTMLAnchorElement>("a[data-occasion]").forEach((a) =>
    a.addEventListener("click", () => {
      const value = a.dataset.occasion;
      if (!select || !value) return;
      select.value = value;
      // Zapytanie z sekcji o personalizacji od razu zaznacza własny kształt.
      if (custom && value === "Zamówienie firmowe z personalizacją") custom.checked = true;
    }),
  );
</script>

<style>
  section[id], .section :global(h2[id]), .section :global(form[id]) { scroll-margin-top: 88px; }

  .season-note { font-weight: 600; color: var(--accent); max-width: 60ch; }
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .jump .chip { text-decoration: none; }
  .jump .chip:hover { border-color: var(--ink-soft); }

  .cats { display: grid; gap: clamp(56px, 8vw, 96px); }

  /* Personalizacja: własne foremki i dowolny kształt */
  .pic { aspect-ratio: 4 / 3; border-radius: var(--radius-lg); align-self: start; }
  .pic :global(.c1) { position: absolute; width: 42%; left: 14%; top: 16%; transform: rotate(-12deg); }
  .pic :global(.c2) { position: absolute; width: 30%; left: 56%; top: 38%; transform: rotate(10deg); }
  .persona { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .persona li { display: grid; grid-template-columns: 34px 1fr; gap: 14px; align-items: start; }
  .persona div { display: grid; gap: 2px; }
  .persona span:not(.pnum) { color: var(--ink-soft); font-size: .95rem; }
  .pnum {
    display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
    font-family: var(--display); font-size: 1.1rem; color: var(--ginger-text);
    background: var(--surface); border: 1.5px solid var(--line);
  }
  .shapes { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .shapes li { font-size: .85rem; padding: 5px 12px; border-radius: 99px; background: var(--surface); border: 1px solid var(--line); }
  .persona-price { font-size: .95rem; max-width: 56ch; padding: 14px 16px; border-radius: 12px; border: 1.5px dashed var(--ginger); }
  .persona-price b { font-family: var(--display); font-weight: 400; font-size: 1.15rem; }

  /* Cennik */
  .price-grid { display: grid; gap: 8px; }
  .price-box { display: grid; gap: 18px; padding: clamp(20px, 4vw, 32px); align-self: start; min-width: 0; }
  .prices { list-style: none; margin: 0; padding: 0; }
  .prices li { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding-block: 12px; border-bottom: 1px dashed var(--line); }
  .prices .name { display: grid; min-width: 0; }
  .prices .name small { color: var(--ink-soft); font-size: .85rem; }
  .prices .price { font-family: var(--display); font-size: 1.25rem; white-space: nowrap; }
  .price-notes { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-size: .92rem; color: var(--ink-soft); }
  .price-notes li { padding-left: 16px; border-left: 3px solid var(--accent); }
  .price-notes b { color: var(--ink); }
  @media (min-width: 760px) {
    .price-grid { grid-template-columns: 0.8fr 1.2fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  }

  /* Ordering process: a real sequence */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; }
  .steps li { display: grid; gap: 8px; align-content: start; }
  .num { font-family: var(--display); font-size: 2.4rem; line-height: 1; color: var(--ginger-text); }
  .steps h3 { font-family: var(--body); font-weight: 700; font-size: 1.15rem; }
  .steps p { color: var(--ink-soft); font-size: .95rem; }
  @media (min-width: 560px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .steps { grid-template-columns: repeat(4, 1fr); } }

  .split { display: grid; gap: 32px; }
  .pitch { display: grid; gap: 22px; align-content: start; min-width: 0; }
  .pitch :global(.section-head) { margin-bottom: 0; }
  .tips { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .tips li { padding-left: 16px; border-left: 3px solid var(--accent); color: var(--ink-soft); }
  .tips b { color: var(--ink); }
  .contact { font-size: .95rem; overflow-wrap: anywhere; }
  .form-box { display: grid; gap: 18px; padding: clamp(20px, 4vw, 32px); align-self: start; min-width: 0; }
  .form-box h3 { font-size: 1.6rem; }
  .form-box .file { padding: 10px; font-size: .9rem; }
  @media (min-width: 900px) { .split { grid-template-columns: 1fr 1fr; gap: 56px; } }

  .faq-grid { display: grid; gap: 8px; }
  @media (min-width: 760px) {
    .faq-grid { grid-template-columns: 0.8fr 1.2fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  }
</style>

# On seohost: ~/mikipierniki-data/.env (chmod 600), loaded by start.mjs. Locally: copy to .env (gitignored).
# Everything is optional for local development: without SMTP_HOST e-mails land in data/mail/
# (in `npm run dev`, or with MAIL_TO_FILES=1 for the built server; never set that on the server).
# Values with spaces go in double quotes.

NODE_ENV=production

# SQLite file, outside public_html
DATABASE_PATH=/home/<user>/mikipierniki-data/mikipierniki.sqlite

# Outgoing mail: the mika@ mailbox on the seohost mail server (port 465, SSL)
SMTP_HOST=h71.seohost.pl
SMTP_PORT=465
SMTP_USER=mika@mikipierniki.pl
SMTP_PASS=
MAIL_FROM="Miki Pierniki <mika@mikipierniki.pl>"
# new sign-ups and inquiries are reported here
MAIL_NOTIFY=mika@mikipierniki.pl

# /panel password (any user name). Long and random: openssl rand -base64 18
PANEL_PASSWORD=
# shared with cron.sh, which calls /api/cron: openssl rand -hex 16
CRON_TOKEN=

# Booking e-mails. Until all three are set the panel won't open terms for booking
# (proposed dates and interest sign-ups work without them).
BANK_ACCOUNT=
BANK_RECIPIENT=
# Sent only in confirmations and reminders, never shown on the site
STUDIO_ADDRESS=

# /etc/mikipierniki.env on the VPS (chmod 600, owner root). Locally: copy to .env (gitignored).
# Everything is optional for local development: without SMTP_HOST e-mails land in data/mail/
# (in `npm run dev`, or with MAIL_TO_FILES=1 for the built server; never set that on the VPS).

# SQLite file (the folder must be writable by the service user)
DATABASE_PATH=/var/lib/mikipierniki/mikipierniki.sqlite

# Outgoing mail through the VPS mail server. Use the host name the mail server's
# TLS certificate is issued for (not 127.0.0.1), port 587 with STARTTLS.
SMTP_HOST=mail.mikipierniki.pl
SMTP_PORT=587
SMTP_USER=warsztaty@mikipierniki.pl
SMTP_PASS=
MAIL_FROM=Miki Pierniki <warsztaty@mikipierniki.pl>
# new sign-ups and inquiries are reported here
MAIL_NOTIFY=warsztaty@mikipierniki.pl

# /panel password (any user name). Long and random: openssl rand -base64 18
PANEL_PASSWORD=
# shared with the systemd timer that calls /api/cron: openssl rand -hex 16
CRON_TOKEN=

# Booking e-mails. Until all three are set the panel won't open terms for booking
# (proposed dates and interest sign-ups work without them).
BANK_ACCOUNT=
BANK_RECIPIENT=
# Sent only in confirmations and reminders, never shown on the site
STUDIO_ADDRESS=
